@namespace Web.Ui.Layout
@inherits LayoutComponentBase

<link href="assets/css/dashboard.css" rel="stylesheet">

<div id="pbar"></div>
<div class="app-shell">

     <!-- سایدبار -->
     <PanelComponent />
     
     <div class="sb-backdrop" id="sbBack"></div>
        <div class="main-col">
            <!-- تاپ‌بار -->
            <header class="topbar">
                <button class="icobtn tb-burger" id="btnBurger" title="منو"><svg class="ic">
                        <use href="assets/img/icons.svg#i-menu" />
                    </svg></button>
                <div class="tb-title">
                    <h1>داشبورد</h1><small>خلاصهٔ وضعیت حقوق و دستمزد — مرداد ۱۴۰۵</small>
                </div>
                <div class="ms-auto d-flex align-items-center gap-2">
                    <span class="tb-date"><svg class="ic">
                            <use href="assets/img/icons.svg#i-calendar" />
                        </svg>شنبه، ۱۷ مرداد ۱۴۰۵</span>
                    <button class="icobtn tb-bell" title="اعلان‌ها"
                        data-demo="۲ اعلان: یک فیش پیش‌نویس در انتظار تأیید است."><svg class="ic">
                            <use href="assets/img/icons.svg#i-bell" />
                        </svg></button>
                </div>
            </header>
            <main class="main-content">
              @Body
            </main>
            <footer class="app-foot">سامانهٔ حقوق و دستمزد · قالب نمایشی — منطق درج، ویرایش، حذف و محاسبه با <b>.NET</b>
                تکمیل می‌شود · مرداد ۱۴۰۵</footer>
        </div>

</div>

<script src="assets/js/searchable-select.js"></script>
<script src="assets/js/forms.js"></script>