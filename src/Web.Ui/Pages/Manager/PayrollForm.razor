@page "/payrollform/{id:guid}"
@page "/payrollform"
@using Microsoft.AspNetCore.Components.Sections
@layout ManagerLayout

<SectionContent SectionName="Styles">
    <link href="/assets/css/payslip.css" rel="stylesheet"/>
</SectionContent>

<div class="page-head">
    <div class="ph-t">
        <div class="crumb">پنل
            <svg class="ic"><use href="assets/img/icons.svg#i-chl"/></svg>
            <a href="/Payroll">فیش‌های حقوقی</a>
            <svg class="ic"><use href="assets/img/icons.svg#i-chl"/></svg>
            <span>@(IsEdit ? "ویرایش فیش" : "فیش جدید")</span>
        </div>
        <h1>@(IsEdit ? "ویرایش فیش حقوقی" : "صدور فیش جدید")</h1>
        <p>فقط ورودی‌های کارکرد را وارد کنید — محاسبات سمت سرور انجام می‌شود.</p>
    </div>
    <div class="ph-actions">
        <a class="btn btn-g" href="/Payroll">
            <svg class="ic"><use href="assets/img/icons.svg#i-x"/></svg>
            انصراف</a>
    </div>
</div>
<div class="row g-4">
    <div class="col-lg-8">
        <div class="panel">
            <div class="panel-b">
                <EditForm EditContext="@_formHelper.EditContext" OnSubmit="@HandleSubmit">
                    <ValidationMessage TValue="string" For="() => _formHelper.Model.General" class="f-help text-danger"/>

                    <div class="sec">
                        <svg class="ic"><use href="assets/img/icons.svg#i-calendar"/></svg>
                        دوره و کارمند
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6 field">
                            <label class="f-label" for="r-emp"><span class="req-s">*</span>فیشِ چه کسی؟</label>
                            <InputSelect @bind-Value="_formHelper.Model.EmployeeId" class="in" id="r-emp"
                                         data-autofocus disabled="@IsEdit">
                                <option value="">انتخاب کنید...</option>
                                @if (_userEmployees is not null)
                                {
                                    foreach (var employee in _userEmployees)
                                    {
                                        <option value="@employee.Id">@employee.FullName — @employee.PersonalCode</option>
                                    }
                                }
                            </InputSelect>
                            <ValidationMessage TValue="Guid?" For="() => _formHelper.Model.EmployeeId"
                                               class="f-help text-danger"/>
                            <div class="f-help">ترکیب (کارمند، سال، ماه) یکتاست.</div>
                        </div>
                        <div class="col-md-3 field">
                            <label class="f-label" for="r-year"><span class="req-s">*</span>سال</label>
                            <InputSelect @bind-Value="_formHelper.Model.PersianYear" class="in" id="r-year"
                                         disabled="@IsEdit">
                                @foreach (var year in GetPersianYearOptions())
                                {
                                    <option value="@year">@year.ToString().ToPersianNumber()</option>
                                }
                            </InputSelect>
                            <ValidationMessage TValue="int" For="() => _formHelper.Model.PersianYear"
                                               class="f-help text-danger"/>
                        </div>
                        <div class="col-md-3 field">
                            <label class="f-label" for="r-month"><span class="req-s">*</span>ماه</label>
                            <InputSelect @bind-Value="_formHelper.Model.PersianMonth" class="in" id="r-month"
                                         disabled="@IsEdit">
                                @for (var month = 1; month <= 12; month++)
                                {
                                    var monthValue = month;
                                    <option value="@monthValue">@GetPersianMonthName(monthValue)</option>
                                }
                            </InputSelect>
                            <ValidationMessage TValue="int" For="() => _formHelper.Model.PersianMonth"
                                               class="f-help text-danger"/>
                        </div>
                    </div>

                    <div class="sec">
                        <svg class="ic"><use href="assets/img/icons.svg#i-clock"/></svg>
                        کارکرد ماه — روزها
                    </div>
                    <div class="row g-3">
                        <div class="col-md-3 col-6 field">
                            <label class="f-label" for="r-wdays"><span class="req-s">*</span>روزهای کارکرد</label>
                            <InputNumber @bind-Value="_formHelper.Model.WorkedDaysCount" class="in num"
                                         id="r-wdays" min="0" max="31" step="0.5"/>
                            <ValidationMessage TValue="decimal" For="() => _formHelper.Model.WorkedDaysCount"
                                               class="f-help text-danger"/>
                        </div>
                        <div class="col-md-3 col-6 field">
                            <label class="f-label" for="r-abs"><span class="req-s">*</span>روزهای غیبت</label>
                            <InputNumber @bind-Value="_formHelper.Model.AbsenceDaysCount" class="in num"
                                         id="r-abs" min="0" max="31" step="0.5"/>
                            <ValidationMessage TValue="decimal" For="() => _formHelper.Model.AbsenceDaysCount"
                                               class="f-help text-danger"/>
                            <div class="f-help">هر روز = کسر حقوق همان روز.</div>
                        </div>
                        <div class="col-md-3 col-6 field">
                            <label class="f-label" for="r-mission-days"><span class="req-s">*</span>روزهای مأموریت</label>
                            <InputNumber @bind-Value="_formHelper.Model.MissionDays" class="in num"
                                         id="r-mission-days" min="0" max="31"/>
                            <ValidationMessage TValue="int" For="() => _formHelper.Model.MissionDays"
                                               class="f-help text-danger"/>
                        </div>
                        <div class="col-md-3 col-6 field">
                            <label class="f-label" for="r-mission-hours"><span class="req-s">*</span>ساعات مأموریت</label>
                            <div class="d-flex gap-2">
                                <InputNumber @bind-Value="_formHelper.Model.MissionTimeHours" class="in num"
                                             id="r-mission-hours" min="0" max="23" style="flex:1"/>
                                <InputNumber @bind-Value="_formHelper.Model.MissionTimeMinutes" class="in num"
                                             min="0" max="59" style="flex:1"/>
                            </div>
                            <ValidationMessage TValue="int" For="() => _formHelper.Model.MissionTimeHours"
                                               class="f-help text-danger"/>
                            <ValidationMessage TValue="int" For="() => _formHelper.Model.MissionTimeMinutes"
                                               class="f-help text-danger"/>
                            <div class="f-help">ساعت و دقیقه</div>
                        </div>
                    </div>

                    <div class="sec">
                        <svg class="ic"><use href="assets/img/icons.svg#i-clock"/></svg>
                        مرخصی
                    </div>
                    <div class="row g-3">
                        <div class="col-md-4 col-6 field">
                            <label class="f-label" for="r-leave-days"><span class="req-s">*</span>روز</label>
                            <InputNumber @bind-Value="_formHelper.Model.LeaveDays" class="in num"
                                         id="r-leave-days" min="0" max="31"/>
                            <ValidationMessage TValue="int" For="() => _formHelper.Model.LeaveDays"
                                               class="f-help text-danger"/>
                        </div>
                        <div class="col-md-4 col-6 field">
                            <label class="f-label" for="r-leave-hours"><span class="req-s">*</span>ساعت</label>
                            <InputNumber @bind-Value="_formHelper.Model.LeaveHours" class="in num"
                                         id="r-leave-hours" min="0" max="23"/>
                            <ValidationMessage TValue="int" For="() => _formHelper.Model.LeaveHours"
                                               class="f-help text-danger"/>
                        </div>
                        <div class="col-md-4 col-6 field">
                            <label class="f-label" for="r-leave-minutes"><span class="req-s">*</span>دقیقه</label>
                            <InputNumber @bind-Value="_formHelper.Model.LeaveMinutes" class="in num"
                                         id="r-leave-minutes" min="0" max="59"/>
                            <ValidationMessage TValue="int" For="() => _formHelper.Model.LeaveMinutes"
                                               class="f-help text-danger"/>
                            <div class="f-help">استحقاقی با حقوق؛ جزو کارکرد است.</div>
                        </div>
                    </div>

                    <div class="sec">
                        <svg class="ic"><use href="assets/img/icons.svg#i-clock"/></svg>
                        کارکرد ماه — ساعت‌ها
                    </div>
                    <div class="row g-3">
                        <div class="col-md-3 col-6 field">
                            <label class="f-label" for="r-ot"><span class="req-s">*</span>اضافه‌کاری</label>
                            <div class="d-flex gap-2">
                                <InputNumber @bind-Value="_formHelper.Model.OvertimeHours" class="in num"
                                             id="r-ot" min="0" style="flex:1"/>
                                <InputNumber @bind-Value="_formHelper.Model.OvertimeMinutes" class="in num"
                                             min="0" max="59" style="flex:1"/>
                            </div>
                            <ValidationMessage TValue="int" For="() => _formHelper.Model.OvertimeHours"
                                               class="f-help text-danger"/>
                            <ValidationMessage TValue="int" For="() => _formHelper.Model.OvertimeMinutes"
                                               class="f-help text-danger"/>
                            <div class="f-help">ساعت و دقیقه؛ سقف قانونی ۴ ساعت در روز.</div>
                        </div>
                        <div class="col-md-3 col-6 field">
                            <label class="f-label" for="r-night"><span class="req-s">*</span>شب‌کاری</label>
                            <div class="d-flex gap-2">
                                <InputNumber @bind-Value="_formHelper.Model.NightShiftHours" class="in num"
                                             id="r-night" min="0" style="flex:1"/>
                                <InputNumber @bind-Value="_formHelper.Model.NightShiftMinutes" class="in num"
                                             min="0" max="59" style="flex:1"/>
                            </div>
                            <ValidationMessage TValue="int" For="() => _formHelper.Model.NightShiftHours"
                                               class="f-help text-danger"/>
                            <ValidationMessage TValue="int" For="() => _formHelper.Model.NightShiftMinutes"
                                               class="f-help text-danger"/>
                            <div class="f-help">شب = ساعت ۲۲ تا ۶.</div>
                        </div>
                        <div class="col-md-3 col-6 field">
                            <label class="f-label" for="r-fri"><span class="req-s">*</span>جمعه‌کاری</label>
                            <div class="d-flex gap-2">
                                <InputNumber @bind-Value="_formHelper.Model.FridayWorkHours" class="in num"
                                             id="r-fri" min="0" style="flex:1"/>
                                <InputNumber @bind-Value="_formHelper.Model.FridayWorkMinutes" class="in num"
                                             min="0" max="59" style="flex:1"/>
                            </div>
                            <ValidationMessage TValue="int" For="() => _formHelper.Model.FridayWorkHours"
                                               class="f-help text-danger"/>
                            <ValidationMessage TValue="int" For="() => _formHelper.Model.FridayWorkMinutes"
                                               class="f-help text-danger"/>
                        </div>
                        <div class="col-md-3 col-6 field">
                            <label class="f-label" for="r-holiday"><span class="req-s">*</span>تعطیل‌کاری</label>
                            <div class="d-flex gap-2">
                                <InputNumber @bind-Value="_formHelper.Model.HolidayWorkHours" class="in num"
                                             id="r-holiday" min="0" style="flex:1"/>
                                <InputNumber @bind-Value="_formHelper.Model.HolidayWorkMinutes" class="in num"
                                             min="0" max="59" style="flex:1"/>
                            </div>
                            <ValidationMessage TValue="int" For="() => _formHelper.Model.HolidayWorkHours"
                                               class="f-help text-danger"/>
                            <ValidationMessage TValue="int" For="() => _formHelper.Model.HolidayWorkMinutes"
                                               class="f-help text-danger"/>
                        </div>
                    </div>

                    <div class="sec">
                        <svg class="ic"><use href="assets/img/icons.svg#i-percent"/></svg>
                        مبالغ اختیاری و عیدی <small>مبالغ به ریال</small>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-4 field">
                            <label class="f-label" for="r-mission-amount">مبلغ مأموریت <span class="f-badge fb-gold">اختیاری</span></label>
                            <div class="amount">
                                <InputText @bind-Value="_formHelper.Model.MissionAmountOverride" class="in in-ltr"
                                           id="r-mission-amount" inputmode="numeric" placeholder="0"/>
                                <span class="unit">ریال</span>
                            </div>
                            <ValidationMessage TValue="string" For="() => _formHelper.Model.MissionAmountOverride"
                                               class="f-help text-danger"/>
                        </div>
                        <div class="col-md-4 field">
                            <label class="f-label" for="r-performance">کارانه <span class="f-badge fb-gold">اختیاری</span></label>
                            <div class="amount">
                                <InputText @bind-Value="_formHelper.Model.PerformanceBonusAmount" class="in in-ltr"
                                           id="r-performance" inputmode="numeric" placeholder="0"/>
                                <span class="unit">ریال</span>
                            </div>
                            <ValidationMessage TValue="string" For="() => _formHelper.Model.PerformanceBonusAmount"
                                               class="f-help text-danger"/>
                        </div>
                        <div class="col-md-4 field">
                            <label class="f-label" for="r-cash">مزایای نقدی <span class="f-badge fb-gold">اختیاری</span></label>
                            <div class="amount">
                                <InputText @bind-Value="_formHelper.Model.CashBenefitsAmount" class="in in-ltr"
                                           id="r-cash" inputmode="numeric" placeholder="0"/>
                                <span class="unit">ریال</span>
                            </div>
                            <ValidationMessage TValue="string" For="() => _formHelper.Model.CashBenefitsAmount"
                                               class="f-help text-danger"/>
                        </div>
                        @if (_formHelper.Model.PersianMonth == 12)
                        {
                            <div class="col-md-4 field">
                                <label class="f-label" for="r-bonus"><span class="req-s">*</span>نوع عیدی سالانه</label>
                                <InputSelect @bind-Value="_formHelper.Model.AnnualBonusType" class="in" id="r-bonus">
                                    <option value="">انتخاب کنید...</option>
                                    <option value="@UserWorkInputDtoAnnualBonusType.Minimum">حداقل</option>
                                    <option value="@UserWorkInputDtoAnnualBonusType.Maximum">حداکثر</option>
                                </InputSelect>
                                <ValidationMessage TValue="UserWorkInputDtoAnnualBonusType?"
                                                   For="() => _formHelper.Model.AnnualBonusType"
                                                   class="f-help text-danger"/>
                                <div class="f-help">عیدی فقط در ماه اسفند قابل ثبت است.</div>
                            </div>
                        }
                    </div>

                    <div class="form-foot">
                        <button type="submit" class="btn btn-p" disabled="@_isLoading">
                            <svg class="ic"><use href="assets/img/icons.svg#i-check"/></svg>
                            @(IsEdit ? "ذخیرهٔ تغییرات" : "صدور فیش")
                        </button>
                        <a class="btn btn-g ms-auto" href="/Payroll">انصراف</a>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="calc-box @(_calculationDetails is not null ? "tall" : "")">
            <h4>
                <svg class="ic"><use href="assets/img/icons.svg#i-receipt"/></svg>
                تفکیک محاسبه
            </h4>
            @if (_calculationDetails is { } details)
            {
                <div class="crow"><span>وضعیت فیش</span><span>@(details.Status == GetPayrollRecordCalculationDetailsResponseStatus.Paid ? "پرداخت‌شده" : "پیش‌نویس")</span></div>
                <div class="crow"><span>دوره</span><span>@details.PersianYear.ToString().ToPersianNumber() — @GetPersianMonthName(details.PersianMonth)</span></div>

                <div class="calc-sec">ورودی‌های دوره</div>
                <div class="crow"><span>روزهای ماه</span><span>@details.PeriodDaysCount.ToString().ToPersianNumber()</span></div>
                <div class="crow"><span>روز کارکرد استاندارد ماه</span><span>@details.StandardWorkingDaysCount.ToString().ToPersianNumber()</span></div>
                <div class="crow"><span>تعداد جمعه‌های ماه</span><span>@details.FridayCount.ToString().ToPersianNumber()</span></div>
                <div class="crow"><span>روزهای سال خورشیدی</span><span>@details.DaysInYear.ToString().ToPersianNumber()</span></div>

                <div class="calc-sec">کارکرد این ماه</div>
                <div class="crow"><span>روزهای کارکرد</span><span>@FormatDecimal(details.WorkedDaysCount)</span></div>
                <div class="crow"><span>روزهای غیبت</span><span>@FormatDecimal(details.AbsenceDaysCount)</span></div>
                <div class="crow"><span>مرخصی</span><span>@FormatLeave(details.LeaveHours, details.DailyWorkingHours)</span></div>
                <div class="crow"><span>مأموریت</span><span>@FormatDecimal(details.MissionDaysCount) روز و @FormatDecimal(details.MissionHours) ساعت</span></div>
                <div class="crow sub"><span>مبلغ مأموریت (اختیاری)</span><span>@FormatAmountOptional(details.MissionAmountOverride)</span></div>
                <div class="crow"><span>اضافه‌کاری</span><span>@FormatDecimal(details.OvertimeHours) ساعت</span></div>
                <div class="crow"><span>شب‌کاری</span><span>@FormatDecimal(details.NightShiftHours) ساعت</span></div>
                <div class="crow"><span>جمعه‌کاری</span><span>@FormatDecimal(details.FridayWorkHours) ساعت</span></div>
                <div class="crow"><span>تعطیل‌کاری</span><span>@FormatDecimal(details.HolidayWorkHours) ساعت</span></div>
                <div class="crow"><span>کارانه (اختیاری)</span><span>@FormatAmountOptional(details.PerformanceBonusAmount)</span></div>
                <div class="crow"><span>مزایای نقدی (اختیاری)</span><span>@FormatAmountOptional(details.CashBenefitsAmount)</span></div>
                @if (details.IsEsfandPeriod)
                {
                    <div class="crow"><span>نوع عیدی سالانه</span><span>@(details.AnnualBonusType == GetPayrollRecordCalculationDetailsResponseAnnualBonusType.Minimum ? "حداقل" : "حداکثر")</span></div>
                }

                <div class="calc-sec">سقف‌ها و ساعت‌های دوره</div>
                <div class="crow"><span>ساعت کار روزانه</span><span>@FormatDecimal(details.DailyWorkingHours) ساعت</span></div>
                <div class="crow"><span>سقف اضافه‌کاری ماهانه</span><span>@FormatDecimal(details.MaxMonthlyOvertimeHours) ساعت</span></div>
                <div class="crow"><span>سقف جمعه‌کاری ماهانه</span><span>@FormatDecimal(details.MaxFridayHours) ساعت</span></div>
                <div class="crow"><span>سقف شب‌کاری ماهانه</span><span>@FormatDecimal(details.MaxNightShiftHours) ساعت</span></div>

                <div class="calc-sec">اطلاعات حکم حقوقی</div>
                <div class="crow"><span>اعتبار حکم از</span><span>@ToPersianDate(details.DecreeEffectiveFrom)</span></div>
                <div class="crow"><span>پایهٔ حقوق روزانه</span><span>@FormatAmount(details.BaseDailySalary)</span></div>
                <div class="crow"><span>حق جذب</span><span>@FormatAmountOptional(details.AttractionAllowance)</span></div>
                <div class="crow"><span>حق سرپرستی</span><span>@FormatAmountOptional(details.SupervisionAllowance)</span></div>
                <div class="crow"><span>ایاب و ذهاب (روزانه)</span><span>@FormatAmountOptional(details.TransportationAllowanceNet)</span></div>
                <div class="crow"><span>تعداد فرزندان</span><span>@details.ChildrenCount.ToString().ToPersianNumber()</span></div>
                <div class="crow"><span>وضعیت تأهل</span><span>@GetMaritalStatusName(details.MaritalStatus)</span></div>
                <div class="crow"><span>نوع شیفت</span><span>@GetShiftTypeName(details.ShiftType)</span></div>
                <div class="crow"><span>نوع قرارداد</span><span>@GetContractTypeName(details.ContractType)</span></div>
                <div class="crow"><span>مشمول مالیات</span><span>@(details.IsTaxSubject ? "بله" : "خیر")</span></div>

                <div class="calc-sec">بازۀ سالانه</div>
                <div class="crow"><span>روزهای کارکرد سال تا قبل از این ماه</span><span>@FormatDecimal(details.PreviousAnnualWorkedDaysCount)</span></div>
                <div class="crow"><span>مجموع روزهای کارکرد سال با این ماه</span><span>@FormatDecimal(details.AnnualWorkedDaysCount)</span></div>

                <div class="calc-sec">قوانین کار معتبر در این دوره</div>
                <table class="rule-tbl">
                    @foreach (var rule in details.RuleValues)
                    {
                        <tr>
                            <td>@GetRuleLabel(rule.Key)</td>
                            <td>@FormatDecimal(rule.Value)</td>
                        </tr>
                    }
                </table>

                <div class="calc-sec">تفکیک مبالغ محاسبه‌شده</div>
                <div class="crow"><span>پایهٔ حقوق ماهانه</span><span>@FormatAmount(details.CalculatedAmounts.BaseSalaryAmount)</span></div>
                <div class="crow"><span>حق جذب</span><span>@FormatAmount(details.CalculatedAmounts.AttractionAllowanceAmount)</span></div>
                <div class="crow"><span>حق سرپرستی</span><span>@FormatAmount(details.CalculatedAmounts.SupervisionAllowanceAmount)</span></div>
                <div class="crow"><span>فوق‌العادهٔ شب‌کاری</span><span>@FormatAmount(details.CalculatedAmounts.NightShiftExtraAmount)</span></div>
                <div class="crow"><span>مبلغ تعطیل‌کاری</span><span>@FormatAmount(details.CalculatedAmounts.HolidayWorkAmount)</span></div>
                <div class="crow"><span>حق اولاد</span><span>@FormatAmount(details.CalculatedAmounts.ChildAllowanceAmount)</span></div>
                <div class="crow"><span>حق مسکن</span><span>@FormatAmount(details.CalculatedAmounts.HousingAllowanceAmount)</span></div>
                <div class="crow"><span>حق بن و خوار و بار</span><span>@FormatAmount(details.CalculatedAmounts.FoodAllowanceAmount)</span></div>
                <div class="crow"><span>حق تأهل</span><span>@FormatAmount(details.CalculatedAmounts.MarriageAllowanceAmount)</span></div>
                <div class="crow"><span>اضافه‌کاری</span><span>@FormatAmount(details.CalculatedAmounts.OvertimeAmount)</span></div>
                <div class="crow"><span>نوبت‌کاری</span><span>@FormatAmount(details.CalculatedAmounts.ShiftWorkAmount)</span></div>
                <div class="crow"><span>مأموریت روزانه</span><span>@FormatAmount(details.CalculatedAmounts.DailyMissionAmount)</span></div>
                <div class="crow"><span>حق کار جمعه</span><span>@FormatAmount(details.CalculatedAmounts.FridayWorkAllowance)</span></div>
                <div class="crow"><span>سنوات پایان سال</span><span>@FormatAmount(details.CalculatedAmounts.EndOfServiceAmount)</span></div>
                <div class="crow"><span>عیدی سالانه</span><span>@FormatAmountOptional(details.CalculatedAmounts.AnnualBonusAmount)</span></div>
                <div class="crow"><span>ایاب و ذهاب</span><span>@FormatAmount(details.CalculatedAmounts.CommutingAllowanceAmount)</span></div>
                <div class="crow"><span>کارانه</span><span>@FormatAmountOptional(details.CalculatedAmounts.PerformanceBonusAmount)</span></div>
                <div class="crow"><span>مزایای نقدی</span><span>@FormatAmountOptional(details.CalculatedAmounts.CashBenefitsAmount)</span></div>
                <div class="crow tot"><span>جمع حقوق و دستمزد</span><span>@FormatAmount(details.Amounts.GrossAmount)</span></div>
                <div class="crow ded"><span>بیمهٔ ۷٪</span><span>−@FormatAmount(details.Amounts.InsuranceAmount)</span></div>
                <div class="crow ded"><span>مالیات</span><span>−@FormatAmount(details.Amounts.CalculatedTaxAmount)</span></div>
                <div class="crow"><span>مجموع کسورات</span><span>−@FormatAmount(details.Amounts.TotalDeductionsAmount)</span></div>
                <div class="cnet"><span>خالص پرداختی</span><b>@FormatAmount(details.Amounts.NetPayableAmount)</b></div>
            }
            else if (_detailsError is not null)
            {
                <div class="calc-note err">
                    <svg class="ic"><use href="assets/img/icons.svg#i-info"/></svg>
                    <div>@_detailsError</div>
                </div>
            }
