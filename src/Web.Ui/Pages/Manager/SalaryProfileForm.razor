@page "/salaryprofile-form"
@layout ManagerLayout

<div class="page-head">
    <div class="ph-t">
        <div class="crumb">پنل
            <svg class="ic">
                <use href="assets/img/icons.svg#i-chl"/>
            </svg>
            <a href="profiles.html">احکام حقوقی</a>
            <svg class="ic">
                <use href="assets/img/icons.svg#i-chl"/>
            </svg>
            حکم جدید
        </div>
        <h1>صدور حکم حقوقی جدید</h1>
        <p>تصمیم‌های مدیر و قرارداد — جدا از اعداد دولتی. با <span class="kbd">Enter</span> جلو بروید.
        </p>
    </div>
    <div class="ph-actions">
        <a class="btn btn-g" href="profiles.html">
            <svg class="ic">
                <use href="assets/img/icons.svg#i-x"/>
            </svg>
            انصراف</a>
        <button class="btn btn-p" data-demo="حکم به‌صورت نمایشی صادر شد.">
            <svg class="ic">
                <use href="assets/img/icons.svg#i-check"/>
            </svg>
            صدور حکم
        </button>
    </div>
</div>
<div class="panel">
    <div class="panel-b">
        <form>
            <input type="hidden" name="Id">
            <div class="sec">
                <svg class="ic">
                    <use href="assets/img/icons.svg#i-calendar"/>
                </svg>
                بازهٔ اعتبار <small>EffectiveFrom / EffectiveTo</small></div>
            <div class="row g-3">
                <div class="col-md-5 field">
                    <label class="f-label" for="p-emp"><span class="req-s">*</span>برای کدام کارمند؟
                        <span class="f-badge fb-grn">EmployeeId</span></label>
                    <select class="in" id="p-emp" data-autofocus>
                        <option>رضا محمدی — P-1001</option>
                        <option>زهرا کریمی — P-1002</option>
                        <option>حسین عباسی — P-1003</option>
                        <option>فاطمه نادری — P-1004</option>
                        <option>مریم صادقی — P-1005</option>
                    </select>
                </div>
                <div class="col-md-3 field">
                    <label class="f-label" for="p-from"><span class="req-s">*</span>از تاریخ</label>
                    <input class="in num" id="p-from" value="۱۴۰۵/۰۶/۰۱" inputmode="numeric">
                    <div class="f-help">معمولاً روز بعد از پایان حکم قبل.</div>
                </div>
                <div class="col-md-4 field">
                    <label class="f-label" for="p-to">تا تاریخ <span
                            class="f-badge fb-gold">اختیاری</span></label>
                    <input class="in num" id="p-to" placeholder="خالی = حکم باز" inputmode="numeric">
                </div>
            </div>
            <div class="sec">
                <svg class="ic">
                    <use href="assets/img/icons.svg#i-coins"/>
                </svg>
                پایه و مزایای ماهانه <small>مبالغ به ریال</small></div>
            <div class="row g-3">
                <div class="col-md-4 field">
                    <label class="f-label" for="p-base"><span class="req-s">*</span>حقوق پایهٔ ماهانه
                        (۳۰ روزه) <span class="f-badge fb-grn">BaseMonthlySalary</span></label>
                    <div class="amount"><input class="in" id="p-base" value="1280000000"
                                               inputmode="numeric"><span class="unit">ریال</span></div>
                    <div class="f-help">کف: حداقل قانونی منطقه در سال شروع حکم.</div>
                </div>
                <div class="col-md-4 field">
                    <label class="f-label" for="p-attr">حق جذب <span
                            class="f-badge fb-gold">اختیاری</span></label>
                    <div class="amount"><input class="in" id="p-attr" value="0"
                                               inputmode="numeric"><span class="unit">ریال</span></div>
                </div>
                <div class="col-md-4 field">
                    <label class="f-label" for="p-super">حق سرپرستی <span
                            class="f-badge fb-gold">اختیاری</span></label>
                    <div class="amount"><input class="in" id="p-super" value="0"
                                               inputmode="numeric"><span class="unit">ریال</span></div>
                </div>
            </div>
            <div class="sec">
                <svg class="ic">
                    <use href="assets/img/icons.svg#i-clock"/>
                </svg>
                سنوات
            </div>
            <div class="row g-3">
                <div class="col-md-4 field">
                    <label class="f-label" for="p-senmode"><span class="req-s">*</span>نحوهٔ اعمال پایه
                        سنوات <span class="f-badge fb-grn">SeniorityBaseApplicationMode</span></label>
                    <select class="in" id="p-senmode">
                        <option value="fixed">ثابت (مقدار دستی)</option>
                        <option value="auto">خودکار (سیستم حساب می‌کند)</option>
                    </select>
                </div>
                <div class="col-md-4 field dis" id="fld-senmethod">
                    <label class="f-label" for="p-senmethod">روش محاسبهٔ پایه سنوات <span
                            class="f-badge fb-blu">وابسته</span></label>
                    <select class="in" id="p-senmethod" disabled>
                        <option value="">انتخاب کنید…</option>
                        <option>روزانه</option>
                        <option>تجمیعی خودکار</option>
                    </select>
                    <div class="f-help">فقط وقتی «نحوهٔ اعمال» خودکار باشد پر می‌شود.</div>
                </div>
                <div class="col-md-4 field">
                    <label class="f-label" for="p-yearend"><span class="req-s">*</span>نحوهٔ سنوات پایان
                        سال <span class="f-badge fb-grn">YearEndSeniorityMode</span></label>
                    <select class="in" id="p-yearend">
                        <option>محاسبه ماهانه (تعهدی)</option>
                        <option>محاسبه سالانه (یکجا)</option>
                        <option>بدون محاسبه</option>
                    </select>
                </div>
            </div>
            <div class="sec">
                <svg class="ic">
                    <use href="assets/img/icons.svg#i-scale"/>
                </svg>
                شیفت و مزایای مصوب
            </div>
            <div class="row g-3">
                <div class="col-md-4 field">
                    <label class="f-label" for="p-shift"><span class="req-s">*</span>نوع شیفت <span
                            class="f-badge fb-grn">ShiftType</span></label>
                    <select class="in" id="p-shift">
                        <option>بدون شیفت (۰٪)</option>
                        <option selected>صبح‌عصر (۱۰٪)</option>
                        <option>صبح‌شب (۲۲٫۵٪)</option>
                        <option>عصر‌شب (۲۲٫۵٪)</option>
                        <option>صبح‌عصر‌شب (۱۵٪)</option>
                    </select>
                    <div class="f-help">درصدها ثابت قانونی‌اند و در بخشنامه‌ها نگهداری می‌شوند.</div>
                </div>
                <div class="col-md-4 field">
                    <label class="f-label" for="p-house">حق مسکن <span
                            class="f-badge fb-gold">HousingAllowance</span></label>
                    <div class="amount"><input class="in" id="p-house" value="140000000"
                                               inputmode="numeric"><span class="unit">ریال</span></div>
                    <div class="f-help">کف مصوب شورای عالی کار رعایت شود.</div>
                </div>
                <div class="col-md-4 field">
                    <label class="f-label" for="p-food">خواربار و بن <span
                            class="f-badge fb-gold">FoodAllowance</span></label>
                    <div class="amount"><input class="in" id="p-food" value="220000000"
                                               inputmode="numeric"><span class="unit">ریال</span></div>
                </div>
                <div class="col-md-4 field">
                    <label class="f-label" for="p-child">حق اولاد هر فرزند <span
                            class="f-badge fb-gold">ChildAllowancePerChild</span></label>
                    <div class="amount"><input class="in" id="p-child" value="104468664"
                                               inputmode="numeric"><span class="unit">ریال</span></div>
                    <div class="f-help">پرداختی ماهانه = این مبلغ × تعداد فرزندان پرونده.</div>
                </div>
                <div class="col-md-4 field">
                    <label class="f-label" for="p-trans">ایاب‌وذهاب (خالص) <span
                            class="f-badge fb-blu">خالص</span></label>
                    <div class="amount"><input class="in" id="p-trans" value="0"
                                               inputmode="numeric"><span class="unit">ریال</span></div>
                    <div class="f-help">کسورات به آن اعمال نمی‌شود.</div>
                </div>
                <div class="col-md-4 field dis">
                    <label class="f-label" for="p-kar">کارانه (خالص) <span class="f-badge fb-red">در
                                            انتظار تصمیم</span></label>
                    <div class="amount"><input class="in" id="p-kar" value="0" inputmode="numeric"
                                               disabled><span class="unit">ریال</span></div>
                    <div class="f-help">آیتم باز سند دامنه — تا تعیین تکلیف در محاسبات نادیده گرفته
                        می‌شود.
                    </div>
                </div>
                <div class="col-md-4 field">
                    <label class="f-label" for="p-attend">مزایای نقدی بر اساس کارکرد</label>
                    <div class="amount"><input class="in" id="p-attend" value="0"
                                               inputmode="numeric"><span class="unit">ریال</span></div>
                    <div class="f-help">پرداخت نهایی در فیش و بر اساس حضور همان ماه.</div>
                </div>
            </div>
            <div class="note n-gold">
                <svg class="ic">
                    <use href="assets/img/icons.svg#i-info"/>
                </svg>
                <div>حقوق پایه مبلغ توافقی است، فقط نباید از حداقل قانونی منطقه کمتر باشد. حق اولاد
                    عمداً اینجاست چون «مبلغ دلبخواه مدیر» است؛ سقف قانونی آن (در صورت اعلام) به
                    بخشنامه‌ها می‌رود.
                </div>
            </div>
            <div class="form-foot">
                <button type="button" class="btn btn-g"
                        data-demo="حکم به‌عنوان پیش‌نویس ذخیره شد (نمایشی).">ذخیره پیش‌نویس
                </button>
                <button type="button" class="btn btn-p" data-demo="حکم به‌صورت نمایشی صادر شد.">
                    <svg
                        class="ic">
                        <use href="assets/img/icons.svg#i-check"/>
                    </svg>
                    صدور حکم
                </button>
                <a class="btn btn-g ms-auto" href="profiles.html">انصراف</a>
            </div>
        </form>
    </div>
</div>