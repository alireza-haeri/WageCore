@page "/site-manager/calculation-formula-form/{id:guid}"
@page "/site-manager/calculation-formula-form"
@layout SiteManagerLayout
@attribute [Authorize(Roles = AppRoles.SiteManagerRule)]

<div class="page-head">
    <div class="ph-t">
        <div class="crumb">
            پنل مدیر سایت
            <svg class="ic">
                <use href="assets/img/icons.svg#i-chl"/>
            </svg>
            <a href="/site-manager/calculation-formulas">فرمول‌های محاسبه</a>
            <svg class="ic">
                <use href="assets/img/icons.svg#i-chl"/>
            </svg>
            <span>@(IsEdit ? "ویرایش فرمول" : "فرمول جدید")</span>
        </div>
        <h1>@(IsEdit ? "ویرایش فرمول محاسبه" : "ثبت فرمول محاسبه جدید")</h1>
        <p>عبارت محاسبه و تاریخ اجرای شمسی را وارد کنید.</p>
    </div>
    <div class="ph-actions">
        <a class="btn btn-g" href="/site-manager/calculation-formulas">
            <svg class="ic">
                <use href="assets/img/icons.svg#i-x"/>
            </svg>
            انصراف
        </a>
    </div>
</div>

<div class="panel">
    <div class="panel-b">
        <EditForm EditContext="@_formHelper.EditContext" OnValidSubmit="@HandleSubmit">
            <ValidationMessage TValue="string" For="() => _formHelper.Model.General" class="f-help text-danger"/>

            <div class="sec">
                <svg class="ic">
                    <use href="assets/img/icons.svg#i-doc"/>
                </svg>
                مشخصات فرمول
            </div>

            <div class="row g-3">
                <div class="col-md-6 field">
                    <label class="f-label" for="f-key"><span class="req-s">*</span>کلید فرمول</label>
                    <InputSelect @bind-Value="_formHelper.Model.Key" class="in" id="f-key" data-autofocus>
                        <option value="">انتخاب کنید...</option>
                        @foreach (var i in Enum.GetValues<CalculationFormulaKey>())
                        {
                            <option value="@i">@i</option>
                        }
                    </InputSelect>
                    <ValidationMessage TValue="CalculationFormulaKey?" For="() => _formHelper.Model.Key"
                                       class="f-help text-danger"/>
                </div>

                <div class="col-md-6 field">
                    <label class="f-label" for="f-from"><span class="req-s">*</span>تاریخ اجرا</label>
                    <InputText @bind-Value="_formHelper.Model.EffectiveFrom" class="in num" id="f-from"
                               inputmode="numeric" placeholder="۱۴۰۵/۰۱/۰۱"/>
                    <ValidationMessage TValue="string" For="() => _formHelper.Model.EffectiveFrom"
                                       class="f-help text-danger"/>
                    <div class="f-help">شمسی؛ به فرمت ۱۴۰۵/۰۱/۰۱.</div>
                </div>

                <div class="col-md-12 field">
                    <label class="f-label" for="f-expr"><span class="req-s">*</span>عبارت فرمول</label>
                    <InputText @bind-Value="_formHelper.Model.Expression" class="in in-ltr" id="f-expr"
                               placeholder="OvertimeHours * HourlyRate * 1.4"/>
                    <ValidationMessage TValue="string" For="() => _formHelper.Model.Expression"
                                       class="f-help text-danger"/>
                    <div class="f-help">عبارت محاسبه‌ای که در فیش حقوقی استفاده می‌شود.</div>
                </div>
            </div>

            <div class="form-foot">
                <button type="submit" class="btn btn-p" disabled="@_isLoading">
                    @if (_isLoading)
                    {
                        <span>در حال پردازش...</span>
                    }
                    else
                    {
                        <svg class="ic">
                            <use href="assets/img/icons.svg#i-check"/>
                        </svg>
                        <span>@(IsEdit ? "ویرایش فرمول" : "ثبت فرمول")</span>
                    }
                </button>
                <a class="btn btn-g" href="/site-manager/calculation-formulas">انصراف</a>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter] public Guid? Id { get; set; }

    private FormHelper<CalculationFormulaFormModel> _formHelper = new();
    private bool _isLoading;
    private bool IsEdit => Id.HasValue && Id.Value != Guid.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (IsEdit)
        {
            _isLoading = true;
            try
            {
                var result = await ApiService.SendAsync(
                    apiCall: () => ApiClient.GetCalculationFormulaForEditAsync(Id!.Value)
                );

                if (result is { IsSuccess: true })
                {
                    var formula = result.Response;
                    _formHelper.Model = new CalculationFormulaFormModel
                    {
                        Key = (CalculationFormulaKey)formula.Key,
                        Expression = formula.Expression,
                        EffectiveFrom = formula.EffectiveFrom
                    };

                    _formHelper.RebuildEditContext();
                }
                else
                {
                    ToastService.ShowToastError("فرمول مورد نظر یافت نشد.");
                    NavigationManager.NavigateTo("/site-manager/calculation-formulas");
                }
            }
            finally
            {
                _isLoading = false;
            }
        }
    }

    private async Task HandleSubmit()
    {
        if (_isLoading) return;
        _isLoading = true;

        _formHelper.ClearErrors();

        var model = _formHelper.Model;

        if (IsEdit)
        {
            var result = await ApiService.SendAsync(
                apiCall: () => ApiClient.UpdateCalculationFormulaAsync(Id!.Value, new UpdateCalculationFormulaRequest(
                    (UpdateCalculationFormulaRequestCalculationFormulaKey)model.Key!,
                    model.EffectiveFrom,
                    model.Expression
                )),
                successMessage: "فرمول با موفقیت ویرایش شد.",
                showErrorToastValidation: false
            );

            if (result is { IsSuccess: true })
            {
                NavigationManager.NavigateTo("/site-manager/calculation-formulas");
            }
            else if (result != null)
            {
                _formHelper.SetServerErrors(result.Errors);
                ToastService.ShowToastWarning("لطفاً خطاها را بررسی کنید.");
            }
        }
        else
        {
            var result = await ApiService.SendAsync(
                apiCall: () => ApiClient.CreateCalculationFormulaAsync(new CreateCalculationFormulaRequest(
                    calculationFormulaKey: (CreateCalculationFormulaRequestCalculationFormulaKey)model.Key!.Value,
                    effectiveFrom: model.EffectiveFrom,
                    expression: model.Expression
                )),
                successMessage: "فرمول با موفقیت ثبت شد.",
                showErrorToastValidation: false
            );

            if (result is { IsSuccess: true })
            {
                NavigationManager.NavigateTo("/site-manager/calculation-formulas");
            }
            else if (result != null)
            {
                _formHelper.SetServerErrors(result.Errors);
                ToastService.ShowToastWarning("لطفاً خطاها را بررسی کنید.");
            }
        }

        _isLoading = false;
    }

    public class CalculationFormulaFormModel : BaseModel
    {
        [Required(ErrorMessage = "کلید فرمول اجباری است.")]
        [Display(Name = "کلید فرمول")]
        public CalculationFormulaKey? Key { get; set; }

        [Required(ErrorMessage = "عبارت فرمول اجباری است.")]
        [Display(Name = "عبارت فرمول")]
        public string Expression { get; set; } = string.Empty;

        [Required(ErrorMessage = "تاریخ اجرا اجباری است.")]
        [Display(Name = "تاریخ اجرا")]
        [RegularExpression(@"^\d{4}/\d{2}/\d{2}$", ErrorMessage = "تاریخ را به فرمت ۱۴۰۵/۰۱/۰۱ وارد کنید.")]
        public string EffectiveFrom { get; set; } = null!;
    }

}
