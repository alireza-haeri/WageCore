@namespace Web.Ui.Layout
@inherits LayoutComponentBase

<link href="assets/css/dashboard.css" rel="stylesheet">

<div class="app-shell">

    <SiteManagerPanelComponent/>

    <div class="sb-backdrop" id="sbBack"></div>
    <div class="main-col">
        <header class="topbar">
            <button class="icobtn tb-burger" id="btnBurger" title="منو">
                <svg class="ic">
                    <use href="assets/img/icons.svg#i-menu"/>
                </svg>
            </button>
            <div class="tb-title">
                <h1>قوانین کار</h1><small>مدیریت مبالغ قانونی — حداقل حقوق ماهانه</small>
            </div>
            <div class="ms-auto d-flex align-items-center gap-2">
                    <span class="tb-date"><svg class="ic">
                            <use href="assets/img/icons.svg#i-calendar"/>
                        </svg>پنل مدیر سایت</span>
            </div>
        </header>
        <main class="main-content">
            @Body
        </main>
        
        <div id="pbar"></div>
        <div class="toast-zone" id="toastZone"></div>
        
        <footer class="app-foot">سامانهٔ حقوق و دستمزد · پنل مدیر سایت
        </footer>
    </div>

</div>

<script src="/assets/js/searchable-select.js"></script>
<script src="/assets/js/forms.js"></script>

@code {
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated is true &&
            !authState.User.IsInRole(AppRoles.SiteManagerRule))
        {
            NavigationManager.NavigateTo("/dashboard");
        }
    }
}
