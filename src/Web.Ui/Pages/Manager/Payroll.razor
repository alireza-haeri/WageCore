@page "/Payroll"
@layout ManagerLayout
@implements IDisposable

<div class="page-head">
    <div class="ph-t">
        <div class="crumb">پنل
            <svg class="ic">
                <use href="assets/img/icons.svg#i-chl"/>
            </svg>
            فیش‌های حقوقی
        </div>
        <h1>فیش‌های حقوقی</h1>
        <p>فیش هر ماه = حکم کارمند + کارکرد ماه + بخشنامهٔ همان سال.</p>
    </div>
    <div class="ph-actions">
        <a class="btn btn-p" href="/payrollform">
            <svg class="ic">
                <use href="assets/img/icons.svg#i-plus"/>
            </svg>
            صدور فیش جدید</a>
    </div>
</div>
<div class="panel">
    <div class="toolbar">
        <div class="srch">
            <svg class="ic">
                <use href="assets/img/icons.svg#i-search"/>
            </svg>
            <input placeholder="جست‌وجو با نام، کد ملی یا کد پرسنلی…"
                   value="@_search"
                   @oninput="OnSearchInput"/></div>
        <select class="in tb-sel" @bind="_selectedWorkshopId" @bind:after="OnWorkshopChanged">
            <option value="">همهٔ کارگاه‌ها</option>
            @if (_userWorkshops is not null)
            {
                foreach (var workshop in _userWorkshops)
                {
                    <option value="@workshop.WorkshopId">@workshop.DisplayName</option>
                }
            }
        </select>
        <select class="in tb-sel" @bind="_selectedDepartmentId" @bind:after="OnDepartmentChanged">
            <option value="">همهٔ بخش‌ها</option>
            @if (_userDepartments is not null)
            {
                foreach (var department in _userDepartments)
                {
                    <option value="@department.DepartmentId">@department.DisplayName</option>
                }
            }
        </select>
        <select class="in tb-sel" @bind="_selectedPersianYear" @bind:after="OnPersianYearChanged">
            <option value="">همهٔ سال‌ها</option>
            @foreach (var year in GetPersianYearOptions())
            {
                <option value="@year">@year.ToString().ToPersianNumber()</option>
            }
        </select>
        <select class="in tb-sel" @bind="_selectedPersianMonth" @bind:after="OnPersianMonthChanged">
            <option value="">همهٔ ماه‌ها</option>
            @for (var month = 1; month <= 12; month++)
            {
                var monthValue = month;
                <option value="@monthValue">@GetPersianMonthName(monthValue)</option>
            }
        </select>
        <span class="chip c-grn ms-auto">
            <span class="c-dot"></span>@((_payrollRecords?.TotalCount ?? 0).ToPersianNumber()) فیش
        </span>
    </div>
    <div class="panel-b p-0">
        @if (_isLoading)
        {
            <div class="text-center p-4">
                <span>در حال بارگذاری...</span>
            </div>
        }
        else if (_payrollRecords is null || _payrollRecords.Items.Count == 0)
        {
            <div class="text-center p-4" style="color:var(--muted)">
                <svg class="ic" style="width:32px;height:32px;opacity:.5">
                    <use href="assets/img/icons.svg#i-doc"/>
                </svg>
                <p class="mt-2">فیشی یافت نشد.</p>
            </div>
        }
        else
        {
            <div class="tblwrap">
                <table class="tbl">
                    <thead>
                    <tr>
                        <th>کارمند</th>
                        <th>دوره</th>
                        <th>کارکرد</th>
                        <th>ناخالص (ریال)</th>
                        <th>کسورات (ریال)</th>
                        <th>خالص (ریال)</th>
                        <th>وضعیت</th>
                        <th style="text-align:left">عملیات</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var record in _payrollRecords.Items)
                    {
                        <tr>
                            <td class="pname">@record.EmployeeName
                                <span class="sub"><span class="ltr">@record.PersonalCode</span> · @record.DepartmentName</span>
                            </td>
                            <td class="num">@record.DisplayPeriod</td>
                            <td class="num">@record.WorkedDaysCount.ToString("0.##").ToPersianNumber() روز
                                @if (record.OvertimeHours > 0)
                                {
                                    <span class="sub">@record.OvertimeHours.ToString("0.##").ToPersianNumber() ساعت اضافه</span>
                                }
                            </td>
                            <td class="mnum">@FormatAmount(record.GrossAmount)</td>
                            <td class="mnum neg">@FormatAmount(record.TotalDeductionsAmount)</td>
                            <td class="mnum pos">@FormatAmount(record.NetPayableAmount)</td>
                            <td>
                                <span class="chip @GetStatusChipClass((int)record.Status)">
                                    <span class="c-dot"></span>@GetStatusDisplayName((int)record.Status)
                                </span>
                            </td>
                            <td>
                                <span class="rowact">
                                    <a class="icobtn" href="/payrollform/@record.PayrollRecordId" title="ویرایش">
                                        <svg class="ic"><use href="assets/img/icons.svg#i-pen"/></svg>
                                    </a>
                                    @if (record.Status == GetPayrollRecordsResponseStatus.Draft)
                                    {
                                        <button class="icobtn" title="ثبت پرداخت"
                                                @onclick="() => ConfirmMarkAsPaid(record)"
                                                disabled="@(_isPaying)">
                                            <svg class="ic"><use href="assets/img/icons.svg#i-check"/></svg>
                                        </button>
                                    }
                                    <button class="icobtn danger" title="حذف"
                                            @onclick="() => ConfirmDelete(record)"
                                            disabled="@(_isDeleting)">
                                        <svg class="ic"><use href="assets/img/icons.svg#i-trash"/></svg>
                                    </button>
                                </span>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @if (_payrollRecords is not null && _payrollRecords.Items.Count > 0)
    {
        <div class="panel-f">
            نمایش @_payrollRecords.Items.Count.ToPersianNumber() فیش از @_payrollRecords.TotalCount.ToPersianNumber()

            @if (_totalPages > 1)
            {
                <div class="d-flex justify-content-center align-items-center gap-2 ms-auto">
                    <button class="btn btn-g" disabled="@(_pageNumber <= 1)"
                            @onclick="() => GoToPage(_pageNumber - 1)">
                        قبلی
                    </button>

                    @foreach (var pageNum in GetPageNumbers())
                    {
                        if (pageNum == -1)
                        {
                            <span style="padding:0 8px">...</span>
                        }
                        else
                        {
                            <button class="btn @(pageNum == _pageNumber ? "btn-p" : "btn-g")"
                                    @onclick="() => GoToPage(pageNum)">
                                @pageNum
                            </button>
                        }
                    }

                    <button class="btn btn-g" disabled="@(_pageNumber >= _totalPages)"
                            @onclick="() => GoToPage(_pageNumber + 1)">
                        بعدی
                    </button>
                </div>
            }
        </div>
    }
</div>

@if (_recordToDelete is not null)
{
    <div class="modal-backdrop show" style="z-index:1040"></div>
    <div class="modal show d-block" tabindex="-1" style="z-index:1050">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">تأیید حذف</h5>
                    <button type="button" class="btn-close" @onclick="CancelDelete" disabled="@(_isDeleting)"></button>
                </div>
                <div class="modal-body">
                    <p>آیا از حذف فیش <b>«@_recordToDelete.EmployeeName»</b> (@_recordToDelete.DisplayPeriod) اطمینان دارید؟</p>
                    <p class="text-danger" style="font-size:12px">فیش پرداخت‌شده قابل حذف نیست.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-g" @onclick="CancelDelete" disabled="@(_isDeleting)">انصراف</button>
                    <button class="btn btn-danger" @onclick="DeleteRecord" disabled="@(_isDeleting)">
                        @if (_isDeleting)
                        {
                            <span>در حال حذف...</span>
                        }
                        else
                        {
                            <span>حذف</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@if (_recordToPay is not null)
{
    <div class="modal-backdrop show" style="z-index:1040"></div>
    <div class="modal show d-block" tabindex="-1" style="z-index:1050">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">تأیید پرداخت</h5>
                    <button type="button" class="btn-close" @onclick="CancelMarkAsPaid" disabled="@(_isPaying)"></button>
                </div>
                <div class="modal-body">
                    <p>فیش <b>«@_recordToPay.EmployeeName»</b> (@_recordToPay.DisplayPeriod) به‌عنوان پرداخت‌شده ثبت شود؟</p>
                    <p class="text-danger" style="font-size:12px">پس از پرداخت، فیش قابل ویرایش و حذف نیست.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-g" @onclick="CancelMarkAsPaid" disabled="@(_isPaying)">انصراف</button>
                    <button class="btn btn-danger" @onclick="MarkAsPaid" disabled="@(_isPaying)">
                        @if (_isPaying)
                        {
                            <span>در حال ثبت...</span>
                        }
                        else
                        {
                            <span>ثبت پرداخت</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private GetPayrollRecordsResponsePagedResult? _payrollRecords;
    private List<GetUserWorkshopsNameQueryResponseWorkshopName>? _userWorkshops;
    private List<GetUserDepartmentsNameQueryResponseDepartmentName>? _userDepartments;
    private bool _isLoading;
    private string? _search;
    private string _selectedWorkshopId = string.Empty;
    private string _selectedDepartmentId = string.Empty;
    private string _selectedPersianYear = string.Empty;
    private string _selectedPersianMonth = string.Empty;

    private int _pageNumber = 1;
    private const int PageSize = 10;
    private int _totalPages => _payrollRecords is null
        ? 0
        : (int)Math.Ceiling(_payrollRecords.TotalCount / (double)PageSize);

    private Timer? _debounceTimer;
    private GetPayrollRecordsResponse? _recordToDelete;
    private GetPayrollRecordsResponse? _recordToPay;
    private bool _isDeleting;
    private bool _isPaying;

    protected override async Task OnInitializedAsync()
    {
        await LoadWorkshopsAsync();
        await LoadDepartmentsAsync();
        await LoadPayrollRecordsAsync();
    }

    private async Task LoadWorkshopsAsync()
    {
        var result = await ApiService.SendAsync(() => ApiClient.GetUserWorkshopsNameAsync());
        if (result?.IsSuccess is true)
        {
            _userWorkshops = result.Response.WorkshopNames.ToList();
        }
    }

    private async Task LoadDepartmentsAsync()
    {
        if (string.IsNullOrEmpty(_selectedWorkshopId))
        {
            var result = await ApiService.SendAsync(() => ApiClient.GetUserDepartmentsNameAsync());
            if (result?.IsSuccess is true)
            {
                _userDepartments = result.Response.DepartmentNames.ToList();
            }

            return;
        }

        var workshopId = Guid.Parse(_selectedWorkshopId);
        var resultFiltered = await ApiService.SendAsync(() => ApiClient.GetUserDepartmentsAsync(1, 100, null, null, workshopId));
        if (resultFiltered?.IsSuccess is true)
        {
            _userDepartments = resultFiltered.Response.Items
                .Select(x => new GetUserDepartmentsNameQueryResponseDepartmentName(x.Id, x.Name))
                .ToList();
        }
    }

    private async Task LoadPayrollRecordsAsync()
    {
        _isLoading = true;
        StateHasChanged();

        Guid? workshopId = string.IsNullOrEmpty(_selectedWorkshopId)
            ? null
            : Guid.Parse(_selectedWorkshopId);

        Guid? departmentId = string.IsNullOrEmpty(_selectedDepartmentId)
            ? null
            : Guid.Parse(_selectedDepartmentId);

        int? persianYear = int.TryParse(_selectedPersianYear, out var year) ? year : null;
        int? persianMonth = int.TryParse(_selectedPersianMonth, out var month) ? month : null;
        if (persianMonth.HasValue && !persianYear.HasValue)
            persianMonth = null;

        var searchTerm = string.IsNullOrWhiteSpace(_search) ? null : _search.Trim();

        var result = await ApiService.SendAsync(() => ApiClient.GetPayrollRecordsAsync(
            _pageNumber,
            PageSize,
            null,
            searchTerm,
            workshopId,
            departmentId,
            persianYear,
            persianMonth));

        if (result?.IsSuccess is true)
        {
            _payrollRecords = result.Response;
        }

        _isLoading = false;
        StateHasChanged();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString();
        _debounceTimer?.Dispose();
        _debounceTimer = new Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                _pageNumber = 1;
                await LoadPayrollRecordsAsync();
            });
        }, null, 500, Timeout.Infinite);
    }

    private async Task OnWorkshopChanged()
    {
        _selectedDepartmentId = string.Empty;
        _pageNumber = 1;
        await LoadDepartmentsAsync();
        await LoadPayrollRecordsAsync();
    }

    private async Task OnDepartmentChanged()
    {
        _pageNumber = 1;
        await LoadPayrollRecordsAsync();
    }

    private async Task OnPersianYearChanged()
    {
        _pageNumber = 1;
        await LoadPayrollRecordsAsync();
    }

    private async Task OnPersianMonthChanged()
    {
        _pageNumber = 1;
        await LoadPayrollRecordsAsync();
    }

    private IEnumerable<int> GetPersianYearOptions()
    {
        var currentYear = new System.Globalization.PersianCalendar().GetYear(DateTime.Now);
        for (var i = 0; i < 3; i++)
            yield return currentYear - i;
    }

    private static string GetPersianMonthName(int month) => month switch
    {
        1 => "فروردین", 2 => "اردیبهشت", 3 => "خرداد", 4 => "تیر",
        5 => "مرداد", 6 => "شهریور", 7 => "مهر", 8 => "آبان",
        9 => "آذر", 10 => "دی", 11 => "بهمن", 12 => "اسفند",
        _ => string.Empty
    };

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > _totalPages || page == _pageNumber) return;
        _pageNumber = page;
        await LoadPayrollRecordsAsync();
    }

    private IEnumerable<int> GetPageNumbers()
    {
        const int visible = 5;
        if (_totalPages <= visible + 2)
        {
            for (var i = 1; i <= _totalPages; i++) yield return i;
            yield break;
        }

        yield return 1;

        var start = Math.Max(2, _pageNumber - visible / 2);
        var end = Math.Min(_totalPages - 1, start + visible - 1);
        start = Math.Max(2, end - visible + 1);

        if (start > 2) yield return -1;
        for (var i = start; i <= end; i++) yield return i;
        if (end < _totalPages - 1) yield return -1;

        yield return _totalPages;
    }

    private void ConfirmDelete(GetPayrollRecordsResponse record)
    {
        _recordToDelete = record;
    }

    private void CancelDelete()
    {
        if (_isDeleting) return;
        _recordToDelete = null;
    }

    private async Task DeleteRecord()
    {
        if (_recordToDelete is null || _isDeleting) return;

        _isDeleting = true;

        var result = await ApiService.SendAsync(
            apiCall: () => ApiClient.DeletePayrollRecordAsync(
                _recordToDelete.PayrollRecordId,
                _recordToDelete.EmployeeId),
            successMessage: "فیش با موفقیت حذف شد."
        );

        _isDeleting = false;

        if (result?.IsSuccess is true)
        {
            _recordToDelete = null;

            if (_payrollRecords?.Items.Count == 1 && _pageNumber > 1)
            {
                _pageNumber--;
            }

            await LoadPayrollRecordsAsync();
        }
    }

    private void ConfirmMarkAsPaid(GetPayrollRecordsResponse record)
    {
        _recordToPay = record;
    }

    private void CancelMarkAsPaid()
    {
        if (_isPaying) return;
        _recordToPay = null;
    }

    private async Task MarkAsPaid()
    {
        if (_recordToPay is null || _isPaying) return;

        _isPaying = true;

        var result = await ApiService.SendAsync(
            apiCall: () => ApiClient.MarkPayrollRecordAsPaidAsync(
                _recordToPay.PayrollRecordId,
                _recordToPay.EmployeeId),
            successMessage: "پرداخت فیش ثبت شد."
        );

        _isPaying = false;

        if (result?.IsSuccess is true)
        {
            _recordToPay = null;
            await LoadPayrollRecordsAsync();
        }
    }

    private static string FormatAmount(double amount) => ((long)amount).ToPersianNumber();

    private static string GetStatusDisplayName(int status) => status switch
    {
        0 => "پیش‌نویس",
        1 => "پرداخت‌شده",
        _ => "نامشخص"
    };

    private static string GetStatusChipClass(int status) => status switch
    {
        0 => "c-gold",
        1 => "c-grn",
        _ => "c-gray"
    };

    public void Dispose()
    {
        _debounceTimer?.Dispose();
    }
}
