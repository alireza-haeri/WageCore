@page "/salaryprofiles"
@layout ManagerLayout

<div class="page-head">
    <div class="ph-t">
        <div class="crumb">پنل
            <svg class="ic">
                <use href="assets/img/icons.svg#i-chl"/>
            </svg>
            احکام حقوقی
        </div>
        <h1>احکام حقوقی</h1>
        <p>هر تغییر حقوق = یک حکم جدید با تاریخ؛ حکم‌های قبلی تاریخچه می‌مانند.</p>
    </div>
    <div class="ph-actions">
        <a class="btn btn-p" href="profile-form.html">
            <svg class="ic">
                <use href="assets/img/icons.svg#i-plus"/>
            </svg>
            صدور حکم جدید</a>
    </div>
</div>
<div class="panel">
    <div class="toolbar">
        <div class="srch">
            <svg class="ic">
                <use href="assets/img/icons.svg#i-search"/>
            </svg>
            <input placeholder="جست‌وجوی نام کارمند…"></div>
        <select class="in tb-sel">
            <option>همهٔ وضعیت‌ها</option>
            <option>فعال</option>
            <option>منقضی</option>
        </select>
        <span class="chip c-grn ms-auto"><span class="c-dot"></span>۵ حکم فعال · ۱ منقضی</span>
    </div>
    <div class="tblwrap">
        <table class="tbl">
            <thead>
            <tr>
                <th>کارمند</th>
                <th>بازهٔ اعتبار</th>
                <th>حقوق پایه (۳۰ روزه)</th>
                <th>مزایا و شیفت</th>
                <th>وضعیت</th>
                <th style="text-align:left">عملیات</th>
            </tr>
            </thead>
            <tbody>
            <tr>
                <td class="pname">رضا محمدی<span class="sub">P-1001 · تولید</span></td>
                <td class="num">از ۱۴۰۵/۰۱/۰۱<span class="sub">باز (بدون پایان)</span></td>
                <td class="mnum">۱٬۲۸۰٬۰۰۰٬۰۰۰</td>
                <td><span class="chip c-blu">شیفت صبح‌عصر ۱۰٪</span></td>
                <td><span class="chip c-grn"><span class="c-dot"></span>فعال</span></td>
                <td><span class="rowact"><a class="icobtn" href="profile-form.html"
                                            title="ویرایش"><svg class="ic">
                                                    <use href="assets/img/icons.svg#i-pen"/>
                                                </svg></a><button class="icobtn danger" title="حذف"
                                                                  data-confirm="حذف حکم «رضا محمدی»"><svg class="ic">
                                                    <use href="assets/img/icons.svg#i-trash"/>
                                                </svg></button></span></td>
            </tr>
            <tr>
                <td class="pname">زهرا کریمی<span class="sub">P-1002 · حسابداری</span></td>
                <td class="num">از ۱۴۰۵/۰۳/۰۱<span class="sub">باز (بدون پایان)</span></td>
                <td class="mnum">۱٬۵۴۰٬۰۰۰٬۰۰۰</td>
                <td><span class="chip c-gold">حق جذب ۳۵۰٬۰۰۰٬۰۰۰</span></td>
                <td><span class="chip c-grn"><span class="c-dot"></span>فعال</span></td>
                <td><span class="rowact"><a class="icobtn" href="profile-form.html"
                                            title="ویرایش"><svg class="ic">
                                                    <use href="assets/img/icons.svg#i-pen"/>
                                                </svg></a><button class="icobtn danger" title="حذف"
                                                                  data-confirm="حذف حکم «زهرا کریمی»"><svg class="ic">
                                                    <use href="assets/img/icons.svg#i-trash"/>
                                                </svg></button></span></td>
            </tr>
            <tr>
                <td class="pname">فاطمه نادری<span class="sub">P-1004 · تولید</span></td>
                <td class="num">از ۱۴۰۴/۰۷/۰۱<span class="sub">باز (بدون پایان)</span></td>
                <td class="mnum">۱٬۳۱۰٬۰۰۰٬۰۰۰</td>
                <td><span class="chip c-blu">شیفت صبح‌شب ۲۲٫۵٪</span></td>
                <td><span class="chip c-grn"><span class="c-dot"></span>فعال</span></td>
                <td><span class="rowact"><a class="icobtn" href="profile-form.html"
                                            title="ویرایش"><svg class="ic">
                                                    <use href="assets/img/icons.svg#i-pen"/>
                                                </svg></a><button class="icobtn danger" title="حذف"
                                                                  data-confirm="حذف حکم «فاطمه نادری»"><svg class="ic">
                                                    <use href="assets/img/icons.svg#i-trash"/>
                                                </svg></button></span></td>
            </tr>
            <tr>
                <td class="pname">مریم صادقی<span class="sub">P-1005 · فروش</span></td>
                <td class="num">از ۱۴۰۵/۰۱/۰۱<span class="sub">باز (بدون پایان)</span></td>
                <td class="mnum">۱٬۴۸۰٬۰۰۰٬۰۰۰</td>
                <td><span class="chip c-gray">بدون شیفت</span></td>
                <td><span class="chip c-grn"><span class="c-dot"></span>فعال</span></td>
                <td><span class="rowact"><a class="icobtn" href="profile-form.html"
                                            title="ویرایش"><svg class="ic">
                                                    <use href="assets/img/icons.svg#i-pen"/>
                                                </svg></a><button class="icobtn danger" title="حذف"
                                                                  data-confirm="حذف حکم «مریم صادقی»"><svg class="ic">
                                                    <use href="assets/img/icons.svg#i-trash"/>
                                                </svg></button></span></td>
            </tr>
            <tr>
                <td class="pname">حسین عباسی<span class="sub">P-1003 · انبار</span></td>
                <td class="num">از ۱۴۰۴/۱۱/۰۱<span class="sub">باز (بدون پایان)</span></td>
                <td class="mnum">۱٬۱۹۰٬۰۰۰٬۰۰۰</td>
                <td><span class="chip c-gold">حق سرپرستی ۱۲۰٬۰۰۰٬۰۰۰</span></td>
                <td><span class="chip c-grn"><span class="c-dot"></span>فعال</span></td>
                <td><span class="rowact"><a class="icobtn" href="profile-form.html"
                                            title="ویرایش"><svg class="ic">
                                                    <use href="assets/img/icons.svg#i-pen"/>
                                                </svg></a><button class="icobtn danger" title="حذف"
                                                                  data-confirm="حذف حکم «حسین عباسی»"><svg class="ic">
                                                    <use href="assets/img/icons.svg#i-trash"/>
                                                </svg></button></span></td>
            </tr>
            <tr style="opacity:.6">
                <td class="pname">مریم صادقی<span class="sub">P-1005 · فروش</span></td>
                <td class="num">از ۱۴۰۴/۰۱/۰۱<span class="sub">تا ۱۴۰۴/۱۲/۲۹</span></td>
                <td class="mnum">۱٬۳۵۰٬۰۰۰٬۰۰۰</td>
                <td><span class="chip c-gray">بدون شیفت</span></td>
                <td><span class="chip c-gray"><span class="c-dot"></span>منقضی</span></td>
                <td><span class="rowact"><a class="icobtn" href="profile-form.html"
                                            title="مشاهده"><svg class="ic">
                                                    <use href="assets/img/icons.svg#i-eye"/>
                                                </svg></a></span></td>
            </tr>
            </tbody>
        </table>
    </div>
    <div class="panel-f">
        <svg class="ic" style="width:14px;height:14px">
            <use href="assets/img/icons.svg#i-info"/>
        </svg>
        همپوشانی دو حکم برای یک کارمند ممنوع است؛ فقط آخرین حکم می‌تواند باز باشد.
        <div
            class="pgn">
            <button class="on">۱</button>
        </div>
    </div>
</div>