@page "/salaryprofile-form/{id:guid}"
@page "/salaryprofile-form"
@layout ManagerLayout

<div class="page-head">
    <div class="ph-t">
        <div class="crumb">
            پنل
            <svg class="ic"><use href="assets/img/icons.svg#i-chl"/></svg>
            <a href="/salaryprofiles">احکام حقوقی</a>
            <svg class="ic"><use href="assets/img/icons.svg#i-chl"/></svg>
            <span>@(IsEdit ? "ویرایش حکم" : "حکم جدید")</span>
        </div>
        <h1>@(IsEdit ? "ویرایش حکم حقوقی" : "صدور حکم حقوقی جدید")</h1>
        <p>هر تغییر حقوق = یک حکم جدید با تاریخ؛ مبالغ به ریال و تاریخ شمسی ثبت می‌شود.</p>
    </div>
    <div class="ph-actions">
        <a class="btn btn-g" href="/salaryprofiles">
            <svg class="ic"><use href="assets/img/icons.svg#i-x"/></svg>
            انصراف
        </a>
    </div>
</div>

<div class="panel">
    <div class="panel-b">
        <EditForm EditContext="@_formHelper.EditContext" OnSubmit="@HandleSubmit">
            <ValidationMessage TValue="string" For="() => _formHelper.Model.General" class="f-help text-danger"/>

            <div class="sec">
                <svg class="ic"><use href="assets/img/icons.svg#i-calendar"/></svg>
                بازهٔ اعتبار
            </div>

            <div class="row g-3">
                <div class="col-md-5 field">
                    <label class="f-label" for="p-employee"><span class="req-s">*</span>برای کدام کارمند؟</label>
                    <InputSelect @bind-Value="_formHelper.Model.EmployeeId" class="in" id="p-employee"
                                 data-autofocus disabled="@IsEdit">
                        <option value="">انتخاب کنید...</option>
                        @if (_userEmployees is not null)
                        {
                            foreach (var employee in _userEmployees)
                            {
                                <option value="@employee.Id">@employee.FullName — @employee.PersonalCode</option>
                            }
                        }
                    </InputSelect>
                    <ValidationMessage TValue="Guid?" For="() => _formHelper.Model.EmployeeId"
                                       class="f-help text-danger"/>
                </div>
                <div class="col-md-7 field">
                    <label class="f-label" for="p-from"><span class="req-s">*</span>از تاریخ</label>
                    <InputText @bind-Value="_formHelper.Model.EffectiveFrom" class="in num" id="p-from"
                               inputmode="numeric" placeholder="۱۴۰۵/۰۶/۰۱"/>
                    <ValidationMessage TValue="string" For="() => _formHelper.Model.EffectiveFrom"
                                       class="f-help text-danger"/>
                    <div class="f-help">شمسی؛ به فرمت ۱۴۰۵/۰۶/۰۱. معمولاً روز بعد از پایان حکم قبل.</div>
                </div>
            </div>

            <div class="sec">
                <svg class="ic"><use href="assets/img/icons.svg#i-coins"/></svg>
                پایه و مزایای روزانه <small>مبالغ به ریال</small>
            </div>

            <div class="row g-3">
                <div class="col-md-4 field">
                    <label class="f-label" for="p-base"><span class="req-s">*</span>حقوق پایهٔ روزانه</label>
                    <div class="amount">
                        <InputText @bind-Value="_formHelper.Model.BaseDailySalary" class="in in-ltr" id="p-base"
                                   inputmode="numeric" placeholder="1280000000"/>
                        <span class="unit">ریال</span>
                    </div>
                    <ValidationMessage TValue="string" For="() => _formHelper.Model.BaseDailySalary"
                                       class="f-help text-danger"/>
                    <div class="f-help">عدد صحیح ریال؛ نباید از حداقل قانونی منطقه کمتر باشد.</div>
                </div>
                <div class="col-md-4 field">
                    <label class="f-label" for="p-attr">حق جذب <span class="f-badge fb-gold">اختیاری</span></label>
                    <div class="amount">
                        <InputText @bind-Value="_formHelper.Model.AttractionAllowance" class="in in-ltr" id="p-attr"
                                   inputmode="numeric" placeholder="0"/>
                        <span class="unit">ریال</span>
                    </div>
                    <ValidationMessage TValue="string" For="() => _formHelper.Model.AttractionAllowance"
                                       class="f-help text-danger"/>
                </div>
                <div class="col-md-4 field">
                    <label class="f-label" for="p-super">حق سرپرستی <span class="f-badge fb-gold">اختیاری</span></label>
                    <div class="amount">
                        <InputText @bind-Value="_formHelper.Model.SupervisionAllowance" class="in in-ltr" id="p-super"
                                   inputmode="numeric" placeholder="0"/>
                        <span class="unit">ریال</span>
                    </div>
                    <ValidationMessage TValue="string" For="() => _formHelper.Model.SupervisionAllowance"
                                       class="f-help text-danger"/>
                </div>
            </div>

            <div class="sec">
                <svg class="ic"><use href="assets/img/icons.svg#i-scale"/></svg>
                شیفت و مزایای مصوب
            </div>

            <div class="row g-3">
                <div class="col-md-4 field">
                    <label class="f-label" for="p-shift"><span class="req-s">*</span>نوع شیفت</label>
                    <InputSelect @bind-Value="_formHelper.Model.ShiftType" class="in" id="p-shift">
                        <option value="">انتخاب کنید...</option>
                        <option value="@SalaryDecreeRequestShiftType.None">بدون شیفت</option>
                        <option value="@SalaryDecreeRequestShiftType.MorningEvening">صبح‌عصر</option>
                        <option value="@SalaryDecreeRequestShiftType.MorningNight">صبح‌شب</option>
                        <option value="@SalaryDecreeRequestShiftType.EveningNight">عصر‌شب</option>
                        <option value="@SalaryDecreeRequestShiftType.MorningEveningNight">صبح‌عصر‌شب</option>
                    </InputSelect>
                    <ValidationMessage TValue="SalaryDecreeRequestShiftType?"
                                       For="() => _formHelper.Model.ShiftType"
                                       class="f-help text-danger"/>
                </div>
                <div class="col-md-4 field">
                    <label class="f-label" for="p-contract"><span class="req-s">*</span>نوع قرارداد</label>
                    <InputSelect @bind-Value="_formHelper.Model.ContractType" class="in" id="p-contract">
                        <option value="">انتخاب کنید...</option>
                        <option value="@SalaryDecreeRequestContractType.Permanent">دائم</option>
                        <option value="@SalaryDecreeRequestContractType.Temporary">موقت</option>
                        <option value="@SalaryDecreeRequestContractType.FixedTerm">مدت معین</option>
                    </InputSelect>
                    <ValidationMessage TValue="SalaryDecreeRequestContractType?"
                                       For="() => _formHelper.Model.ContractType"
                                       class="f-help text-danger"/>
                </div>
                <div class="col-md-4 field">
                    <label class="f-label" for="p-trans">ایاب‌وذهاب (خالص) <span class="f-badge fb-gold">اختیاری</span></label>
                    <div class="amount">
                        <InputText @bind-Value="_formHelper.Model.TransportationAllowanceNet" class="in in-ltr" id="p-trans"
                                   inputmode="numeric" placeholder="0"/>
                        <span class="unit">ریال</span>
                    </div>
                    <ValidationMessage TValue="string" For="() => _formHelper.Model.TransportationAllowanceNet"
                                       class="f-help text-danger"/>
                    <div class="f-help">کسورات به آن اعمال نمی‌شود.</div>
                </div>
            </div>

            <div class="sec mt-4">
                <svg class="ic"><use href="assets/img/icons.svg#i-user"/></svg>
                خانواده و مالیات
            </div>

            <div class="row g-3">
                <div class="col-md-4 field">
                    <label class="f-label" for="p-maritalStatus"><span class="req-s">*</span>وضعیت تأهل</label>
                    <InputSelect @bind-Value="_formHelper.Model.MaritalStatus" @bind-Value:after="OnMaritalStatusChanged" class="in" id="p-maritalStatus">
                        <option value="">انتخاب کنید...</option>
                        <option value="@SalaryDecreeRequestMaritalStatus.Single">مجرد</option>
                        <option value="@SalaryDecreeRequestMaritalStatus.Married">متأهل</option>
                        <option value="@SalaryDecreeRequestMaritalStatus.Divorced">مطلقه</option>
                        <option value="@SalaryDecreeRequestMaritalStatus.Widowed">همسر فوت‌شده</option>
                    </InputSelect>
                    <ValidationMessage TValue="SalaryDecreeRequestMaritalStatus?"
                                       For="() => _formHelper.Model.MaritalStatus"
                                       class="f-help text-danger"/>
                </div>

                @if (_formHelper.Model.MaritalStatus != SalaryDecreeRequestMaritalStatus.Single)
                {
                    <div class="col-md-4 field">
                        <label class="f-label" for="p-childrenCount"><span class="req-s">*</span>تعداد فرزندان</label>
                        <InputNumber @bind-Value="_formHelper.Model.ChildrenCount" class="in num" id="p-childrenCount" min="0" max="20"/>
                        <ValidationMessage TValue="int?" For="() => _formHelper.Model.ChildrenCount"
                                           class="f-help text-danger"/>
                    </div>
                }

                <label class="col-md-4">
                    <div class="sw-card">
                        <span class="sw"><InputCheckbox @bind-Value="_formHelper.Model.IsTaxSubject"/><i></i></span>
                        <span class="swt">مشمول مالیات حقوق است؟<span class="swd">در محاسبهٔ فیش لحاظ می‌شود.</span></span>
                    </div>
                </label>
            </div>

            <div class="sec mt-4">
                <svg class="ic"><use href="assets/img/icons.svg#i-shield"/></svg>
                بیمه
            </div>

            <div class="row g-3">
                <div class="col-md-4 field">
                    <label class="f-label" for="p-insuranceNumber"><span class="req-s">*</span>شماره بیمه</label>
                    <InputText @bind-Value="_formHelper.Model.InsuranceNumber" class="in in-ltr" id="p-insuranceNumber" maxlength="20"/>
                    <ValidationMessage TValue="string" For="() => _formHelper.Model.InsuranceNumber"
                                       class="f-help text-danger"/>
                </div>

                <div class="col-md-4 field">
                    <label class="f-label" for="p-positionInInsuranceList"><span class="req-s">*</span>سمت در لیست بیمه</label>
                    <InputText @bind-Value="_formHelper.Model.PositionInInsuranceList" class="in" id="p-positionInInsuranceList" maxlength="100"/>
                    <ValidationMessage TValue="string" For="() => _formHelper.Model.PositionInInsuranceList"
                                       class="f-help text-danger"/>
                </div>

                <div class="col-md-4 field">
                    <label class="f-label" for="p-insuranceCalculationProfile"><span class="req-s">*</span>پروفایل محاسبه بیمه</label>
                    <InputSelect @bind-Value="_formHelper.Model.InsuranceCalculationProfile" class="in" id="p-insuranceCalculationProfile">
                        <option value="">انتخاب کنید...</option>
                        <option value="@EmployeeInsuranceRequestInsuranceCalculationProfile.FullLegal">کامل و قانونی</option>
                        <option value="@EmployeeInsuranceRequestInsuranceCalculationProfile.MinimumLaborLaw">حداقل قانون کار</option>
                    </InputSelect>
                    <ValidationMessage TValue="EmployeeInsuranceRequestInsuranceCalculationProfile?"
                                       For="() => _formHelper.Model.InsuranceCalculationProfile"
                                       class="f-help text-danger"/>
                </div>

                <label class="col-md-3">
                    <div class="sw-card">
                        <span class="sw"><InputCheckbox @bind-Value="_formHelper.Model.IsSubjectTo7PercentInsurance"/><i></i></span>
                        <span class="swt">مشمول بیمهٔ ۷٪</span>
                    </div>
                </label>

                <label class="col-md-3">
                    <div class="sw-card">
                        <span class="sw"><InputCheckbox @bind-Value="_formHelper.Model.IsSubjectTo20PercentInsurance"/><i></i></span>
                        <span class="swt">مشمول بیمهٔ ۲۰٪</span>
                    </div>
                </label>

                <label class="col-md-3">
                    <div class="sw-card">
                        <span class="sw"><InputCheckbox @bind-Value="_formHelper.Model.IsSubjectTo3PercentInsurance"/><i></i></span>
                        <span class="swt">مشمول بیمهٔ ۳٪</span>
                    </div>
                </label>

                <label class="col-md-3">
                    <div class="sw-card">
                        <span class="sw"><InputCheckbox @bind-Value="_formHelper.Model.IsSubjectTo4PercentInsurance"/><i></i></span>
                        <span class="swt">مشمول بیمهٔ ۴٪</span>
                    </div>
                </label>
            </div>

            <div class="note n-gold">
                <svg class="ic"><use href="assets/img/icons.svg#i-info"/></svg>
                <div>حقوق پایه مبلغ توافقی است، فقط نباید از حداقل قانونی منطقه کمتر باشد.</div>
            </div>

            <div class="form-foot">
                <button type="submit" class="btn btn-p" disabled="@_isLoading">
                    @if (_isLoading)
                    {
                        <span>در حال پردازش...</span>
                    }
                    else
                    {
                        <svg class="ic"><use href="assets/img/icons.svg#i-check"/></svg>
                        <span>@(IsEdit ? "ویرایش حکم" : "صدور حکم")</span>
                    }
                </button>
                <a class="btn btn-g" href="/salaryprofiles">انصراف</a>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter] public Guid? Id { get; set; }

    private FormHelper<SalaryProfileFormModel> _formHelper = new(fieldMapping: CreateFieldMapping());
    private List<GetUserEmployeesResponse>? _userEmployees;
    private bool _isLoading;
    private bool IsEdit => Id.HasValue && Id.Value != Guid.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadEmployeesAsync();

        if (IsEdit)
        {
            _isLoading = true;
            try
            {
                var result = await ApiService.SendAsync(
                    apiCall: () => ApiClient.GetSalaryDecreeForEditAsync(Id!.Value)
                );

                if (result is { IsSuccess: true })
                {
                    var profile = result.Response;
                    _formHelper.Model = new SalaryProfileFormModel
                    {
                        EmployeeId = profile.EmployeeId,
                        EffectiveFrom = profile.EffectiveFrom,
                        BaseDailySalary = ((long)profile.BaseDailySalary).ToString(),
                        AttractionAllowance = FormatOptionalAmount(profile.AttractionAllowance),
                        SupervisionAllowance = FormatOptionalAmount(profile.SupervisionAllowance),
                        ShiftType = (SalaryDecreeRequestShiftType)profile.ShiftType,
                        ContractType = (SalaryDecreeRequestContractType)profile.ContractType,
                        TransportationAllowanceNet = FormatOptionalAmount(profile.TransportationAllowanceNet),
                        MaritalStatus = (SalaryDecreeRequestMaritalStatus)profile.MaritalStatus,
                        ChildrenCount = profile.ChildrenCount,
                        IsTaxSubject = profile.IsTaxSubject,
                        InsuranceNumber = profile.InsuranceNumber,
                        PositionInInsuranceList = profile.PositionInInsuranceList,
                        IsSubjectTo7PercentInsurance = profile.IsSubjectTo7PercentInsurance,
                        IsSubjectTo20PercentInsurance = profile.IsSubjectTo20PercentInsurance,
                        IsSubjectTo3PercentInsurance = profile.IsSubjectTo3PercentInsurance,
                        IsSubjectTo4PercentInsurance = profile.IsSubjectTo4PercentInsurance,
                        InsuranceCalculationProfile = (EmployeeInsuranceRequestInsuranceCalculationProfile)profile.InsuranceCalculationProfile
                    };

                    OnMaritalStatusChanged();
                    _formHelper.RebuildEditContext();
                }
                else
                {
                    ToastService.ShowToastError("حکم مورد نظر یافت نشد.");
                    NavigationManager.NavigateTo("/salaryprofiles");
                }
            }
            finally
            {
                _isLoading = false;
            }
        }
    }

    private async Task LoadEmployeesAsync()
    {
        var result = await ApiService.SendAsync(() => ApiClient.GetUserEmployeesAsync(1, 100, null, null, null, null, null));
        if (result?.IsSuccess is true)
        {
            _userEmployees = result.Response.Items.ToList();
        }
    }

    private void OnMaritalStatusChanged()
    {
        if (_formHelper.Model.MaritalStatus == SalaryDecreeRequestMaritalStatus.Single)
            _formHelper.Model.ChildrenCount = 0;
    }

    private async Task HandleSubmit()
    {
        if (_isLoading) return;

        _formHelper.ClearErrors();

        var isFormValid = _formHelper.Validate();
        if (!isFormValid)
        {
            ToastService.ShowToastWarning("لطفاً خطاها را بررسی کنید.");
            return;
        }

        var model = _formHelper.Model;

        if (!long.TryParse(model.BaseDailySalary, out var baseDailySalary))
        {
            _formHelper.SetServerErrors(new Dictionary<string, ICollection<string>>
            {
                { nameof(SalaryProfileFormModel.BaseDailySalary), ["حقوق پایه روزانه باید عدد صحیح ریال باشد."] }
            });
            ToastService.ShowToastWarning("لطفاً خطاها را بررسی کنید.");
            return;
        }

        var childrenCount = model.MaritalStatus == SalaryDecreeRequestMaritalStatus.Single
            ? 0
            : model.ChildrenCount ?? 0;

        var insuranceRequest = new EmployeeInsuranceRequest(
            insuranceCalculationProfile: model.InsuranceCalculationProfile ?? EmployeeInsuranceRequestInsuranceCalculationProfile.FullLegal,
            insuranceNumber: model.InsuranceNumber,
            isSubjectTo20PercentInsurance: model.IsSubjectTo20PercentInsurance,
            isSubjectTo3PercentInsurance: model.IsSubjectTo3PercentInsurance,
            isSubjectTo4PercentInsurance: model.IsSubjectTo4PercentInsurance,
            isSubjectTo7PercentInsurance: model.IsSubjectTo7PercentInsurance,
            positionInInsuranceList: model.PositionInInsuranceList);

        var salaryProfile = new SalaryDecreeRequest(
            attractionAllowance: ParseOptionalAmount(model.AttractionAllowance),
            baseDailySalary: baseDailySalary,
            childrenCount: childrenCount,
            contractType: model.ContractType ?? SalaryDecreeRequestContractType.Permanent,
            effectiveFrom: model.EffectiveFrom,
            insurance: insuranceRequest,
            isTaxSubject: model.IsTaxSubject,
            maritalStatus: model.MaritalStatus ?? SalaryDecreeRequestMaritalStatus.Single,
            shiftType: model.ShiftType ?? SalaryDecreeRequestShiftType.None,
            supervisionAllowance: ParseOptionalAmount(model.SupervisionAllowance),
            transportationAllowanceNet: ParseOptionalAmount(model.TransportationAllowanceNet));

        _isLoading = true;

        if (IsEdit)
        {
            var result = await ApiService.SendAsync(
                apiCall: () => ApiClient.UpdateSalaryDecreeAsync(
                    Id!.Value,
                    new UpdateSalaryDecreeRequest(
                        employeeId: model.EmployeeId ?? Guid.Empty,
                        salaryProfile: salaryProfile)
                ),
                successMessage: "حکم با موفقیت ویرایش شد.",
                showErrorToastValidation: false
            );

            if (result is { IsSuccess: true })
            {
                NavigationManager.NavigateTo("/salaryprofiles");
            }
            else if (result != null)
            {
                _formHelper.SetServerErrors(result.Errors);
                ToastService.ShowToastWarning("لطفاً خطاها را بررسی کنید.");
            }
        }
        else
        {
            var result = await ApiService.SendAsync(
                apiCall: () => ApiClient.CreateSalaryDecreeAsync(
                    new CreateSalaryDecreeRequest(
                        employeeId: model.EmployeeId ?? Guid.Empty,
                        salaryProfile: salaryProfile)
                ),
                successMessage: "حکم با موفقیت صادر شد.",
                showErrorToastValidation: false
            );

            if (result is { IsSuccess: true })
            {
                NavigationManager.NavigateTo("/salaryprofiles");
            }
            else if (result != null)
            {
                _formHelper.SetServerErrors(result.Errors);
                ToastService.ShowToastWarning("لطفاً خطاها را بررسی کنید.");
            }
        }

        _isLoading = false;
    }

    private static string FormatOptionalAmount(decimal? amount)
        => amount.HasValue ? ((long)amount.Value).ToString() : string.Empty;

    private static decimal? ParseOptionalAmount(string? value)
        => string.IsNullOrWhiteSpace(value) ? null : decimal.Parse(value);

    private static Dictionary<string, string> CreateFieldMapping() => new()
    {
        ["EmployeeId"] = nameof(SalaryProfileFormModel.EmployeeId),
        ["EffectiveFrom"] = nameof(SalaryProfileFormModel.EffectiveFrom),
        ["SalaryProfile.EffectiveFrom"] = nameof(SalaryProfileFormModel.EffectiveFrom),
        ["BaseDailySalary"] = nameof(SalaryProfileFormModel.BaseDailySalary),
        ["SalaryProfile.BaseDailySalary"] = nameof(SalaryProfileFormModel.BaseDailySalary),
        ["AttractionAllowance"] = nameof(SalaryProfileFormModel.AttractionAllowance),
        ["SalaryProfile.AttractionAllowance"] = nameof(SalaryProfileFormModel.AttractionAllowance),
        ["SupervisionAllowance"] = nameof(SalaryProfileFormModel.SupervisionAllowance),
        ["SalaryProfile.SupervisionAllowance"] = nameof(SalaryProfileFormModel.SupervisionAllowance),
        ["ShiftType"] = nameof(SalaryProfileFormModel.ShiftType),
        ["SalaryProfile.ShiftType"] = nameof(SalaryProfileFormModel.ShiftType),
        ["ContractType"] = nameof(SalaryProfileFormModel.ContractType),
        ["SalaryProfile.ContractType"] = nameof(SalaryProfileFormModel.ContractType),
        ["TransportationAllowanceNet"] = nameof(SalaryProfileFormModel.TransportationAllowanceNet),
        ["SalaryProfile.TransportationAllowanceNet"] = nameof(SalaryProfileFormModel.TransportationAllowanceNet),
        ["MaritalStatus"] = nameof(SalaryProfileFormModel.MaritalStatus),
        ["SalaryProfile.MaritalStatus"] = nameof(SalaryProfileFormModel.MaritalStatus),
        ["ChildrenCount"] = nameof(SalaryProfileFormModel.ChildrenCount),
        ["SalaryProfile.ChildrenCount"] = nameof(SalaryProfileFormModel.ChildrenCount),
        ["IsTaxSubject"] = nameof(SalaryProfileFormModel.IsTaxSubject),
        ["SalaryProfile.IsTaxSubject"] = nameof(SalaryProfileFormModel.IsTaxSubject),
        ["InsuranceNumber"] = nameof(SalaryProfileFormModel.InsuranceNumber),
        ["SalaryProfile.Insurance.InsuranceNumber"] = nameof(SalaryProfileFormModel.InsuranceNumber),
        ["PositionInInsuranceList"] = nameof(SalaryProfileFormModel.PositionInInsuranceList),
        ["SalaryProfile.Insurance.PositionInInsuranceList"] = nameof(SalaryProfileFormModel.PositionInInsuranceList),
        ["InsuranceCalculationProfile"] = nameof(SalaryProfileFormModel.InsuranceCalculationProfile),
        ["SalaryProfile.Insurance.InsuranceCalculationProfile"] = nameof(SalaryProfileFormModel.InsuranceCalculationProfile)
    };

    public class SalaryProfileFormModel : BaseModel
    {
        [Required(ErrorMessage = "انتخاب کارمند اجباری است.")]
        [Display(Name = "کارمند")]
        public Guid? EmployeeId { get; set; }

        [Required(ErrorMessage = "تاریخ اعمال اجباری است.")]
        [RegularExpression(@"^\d{4}/\d{2}/\d{2}$", ErrorMessage = "تاریخ را به فرمت ۱۴۰۵/۰۶/۰۱ وارد کنید.")]
        [Display(Name = "از تاریخ")]
        public string EffectiveFrom { get; set; } = string.Empty;

        [Required(ErrorMessage = "حقوق پایه روزانه اجباری است.")]
        [RegularExpression(@"^\d+$", ErrorMessage = "حقوق پایه روزانه باید عدد صحیح ریال باشد.")]
        [Display(Name = "حقوق پایه روزانه")]
        public string BaseDailySalary { get; set; } = string.Empty;

        [RegularExpression(@"^(\d+)?$", ErrorMessage = "حق جذب باید عدد صحیح ریال باشد.")]
        [Display(Name = "حق جذب")]
        public string? AttractionAllowance { get; set; }

        [RegularExpression(@"^(\d+)?$", ErrorMessage = "حق سرپرستی باید عدد صحیح ریال باشد.")]
        [Display(Name = "حق سرپرستی")]
        public string? SupervisionAllowance { get; set; }

        [Required(ErrorMessage = "نوع شیفت اجباری است.")]
        [Display(Name = "نوع شیفت")]
        public SalaryDecreeRequestShiftType? ShiftType { get; set; }

        [Required(ErrorMessage = "نوع قرارداد اجباری است.")]
        [Display(Name = "نوع قرارداد")]
        public SalaryDecreeRequestContractType? ContractType { get; set; }

        [RegularExpression(@"^(\d+)?$", ErrorMessage = "حق ایاب و ذهاب خالص باید عدد صحیح ریال باشد.")]
        [Display(Name = "ایاب و ذهاب")]
        public string? TransportationAllowanceNet { get; set; }

        [Required(ErrorMessage = "وضعیت تأهل اجباری است.")]
        [Display(Name = "وضعیت تأهل")]
        public SalaryDecreeRequestMaritalStatus? MaritalStatus { get; set; }

        [Required(ErrorMessage = "تعداد فرزندان اجباری است.")]
        [Range(0, 20, ErrorMessage = "تعداد فرزندان باید بین ۰ تا ۲۰ باشد.")]
        [Display(Name = "تعداد فرزندان")]
        public int? ChildrenCount { get; set; } = 0;

        public bool IsTaxSubject { get; set; } = true;

        [Required(ErrorMessage = "شماره بیمه اجباری است.")]
        [StringLength(20, ErrorMessage = "شماره بیمه نمی‌تواند بیش از ۲۰ نویسه باشد.")]
        public string InsuranceNumber { get; set; } = string.Empty;

        [Required(ErrorMessage = "سمت در لیست بیمه اجباری است.")]
        [StringLength(100, ErrorMessage = "سمت در لیست بیمه نمی‌تواند بیش از ۱۰۰ نویسه باشد.")]
        public string PositionInInsuranceList { get; set; } = string.Empty;

        public bool IsSubjectTo7PercentInsurance { get; set; } = true;
        public bool IsSubjectTo20PercentInsurance { get; set; } = true;
        public bool IsSubjectTo3PercentInsurance { get; set; }
        public bool IsSubjectTo4PercentInsurance { get; set; }

        [Required(ErrorMessage = "پروفایل محاسبه بیمه اجباری است.")]
        public EmployeeInsuranceRequestInsuranceCalculationProfile? InsuranceCalculationProfile { get; set; }
    }
