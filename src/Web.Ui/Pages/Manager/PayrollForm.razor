    private static string FormatOptionalAmount(decimal? amount)
        => amount.HasValue ? ((long)amount.Value).ToString() : string.Empty;

    private static decimal? ParseOptionalAmount(string? value)
        => string.IsNullOrWhiteSpace(value) ? null : decimal.Parse(value);

    private static string FormatAmount(decimal amount) => ((long)amount).ToPersianNumber();

    private static string FormatDecimal(decimal value) => value.ToString("0.##").ToPersianNumber();

    private static string FormatAmountOptional(decimal? amount) => amount.HasValue ? FormatAmount(amount.Value) : "—";

    private static string FormatLeave(decimal leaveHours, decimal dailyWorkingHours)
    {
        if (leaveHours <= 0)
            return "—";

        if (dailyWorkingHours <= 0)
            return FormatDecimal(leaveHours) + " ساعت";

        var days = (int)(leaveHours / dailyWorkingHours);
        var remaining = leaveHours - days * dailyWorkingHours;
        var hours = (int)remaining;
        var minutes = (int)Math.Round((remaining - hours) * 60);
        if (minutes == 60)
        {
            minutes = 0;
            hours += 1;
        }

        return $"{days.ToString().ToPersianNumber()} روز {hours.ToString().ToPersianNumber()} ساعت {minutes.ToString().ToPersianNumber()} دقیقه";
    }

    private static string ToPersianDate(string? isoDate)
    {
        if (!DateTimeOffset.TryParse(isoDate, out var date))
            return isoDate;

        var calendar = new System.Globalization.PersianCalendar();
        var dateTime = date.DateTime;
        return $"{calendar.GetDayOfMonth(dateTime).ToString().ToPersianNumber()}" +
               $"/{calendar.GetMonth(dateTime).ToString().ToPersianNumber()}" +
               $"/{calendar.GetYear(dateTime).ToString().ToPersianNumber()}";
    }

