@page "/salaryprofiles"
@layout ManagerLayout
@implements IDisposable

<div class="page-head">
    <div class="ph-t">
        <div class="crumb">پنل
            <svg class="ic"><use href="assets/img/icons.svg#i-chl"/></svg>
            احکام حقوقی
        </div>
        <h1>احکام حقوقی</h1>
        <p>هر تغییر حقوق = یک حکم جدید با تاریخ؛ حکم‌های قبلی تاریخچه می‌مانند.</p>
    </div>
    <div class="ph-actions">
        <a class="btn btn-p" href="/salaryprofile-form">
            <svg class="ic"><use href="assets/img/icons.svg#i-plus"/></svg>
            صدور حکم جدید
        </a>
    </div>
</div>

<div class="panel">
    <div class="toolbar">
        <div class="srch">
            <svg class="ic"><use href="assets/img/icons.svg#i-search"/></svg>
            <input placeholder="جست‌وجو با نام، کد پرسنلی یا کد ملی…"
                   value="@_search"
                   @oninput="OnSearchInput"/>
        </div>
        <select class="in tb-sel" @bind="_selectedWorkshopId" @bind:after="OnWorkshopChanged">
            <option value="">همهٔ کارگاه‌ها</option>
            @if (_userWorkshops is not null)
            {
                foreach (var workshop in _userWorkshops)
                {
                    <option value="@workshop.WorkshopId">@workshop.DisplayName</option>
                }
            }
        </select>
        <select class="in tb-sel" @bind="_selectedDepartmentId" @bind:after="OnDepartmentChanged">
            <option value="">همهٔ بخش‌ها</option>
            @if (_userDepartments is not null)
            {
                foreach (var department in _userDepartments)
                {
                    <option value="@department.DepartmentId">@department.DisplayName</option>
                }
            }
        </select>
        <select class="in tb-sel" @bind="_selectedStatus" @bind:after="OnStatusChanged">
            <option value="">همهٔ وضعیت‌ها</option>
            <option value="@Status2.Active">فعال</option>
            <option value="@Status2.Expired">منقضی</option>
        </select>
        <span class="chip c-grn ms-auto">
            <span class="c-dot"></span>@((_salaryProfiles?.TotalCount ?? 0).ToPersianNumber()) حکم
        </span>
    </div>

    <div class="panel-b p-0">
        @if (_isLoading)
        {
            <div class="text-center p-4">
                <span>در حال بارگذاری...</span>
            </div>
        }
        else if (_salaryProfiles is null || _salaryProfiles.Items.Count == 0)
        {
            <div class="text-center p-4" style="color:var(--muted)">
                <svg class="ic" style="width:32px;height:32px;opacity:.5">
                    <use href="assets/img/icons.svg#i-doc"/>
                </svg>
                <p class="mt-2">حکمی یافت نشد.</p>
            </div>
        }
        else
        {
            <div class="tblwrap">
                <table class="tbl">
                    <thead>
                    <tr>
                        <th>کارمند</th>
                        <th>تاریخ اعمال</th>
                        <th>حقوق پایه (ریال)</th>
                        <th>وضعیت</th>
                        <th style="text-align:left">عملیات</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var profile in _salaryProfiles.Items)
                    {
                        <tr>
                            <td class="pname">@profile.EmployeeName
                                <span class="sub"><span class="ltr">@profile.PersonalCode</span> · @profile.DepartmentName</span>
                            </td>
                            <td class="num">از @profile.DisplayEffectiveFrom<span class="sub">باز (بدون پایان)</span></td>
                            <td class="mnum">@FormatAmount(profile.BaseDailySalary)</td>
                            <td>
                                <span class="chip @GetStatusChipClass((int)profile.Status)">
                                    <span class="c-dot"></span>@GetStatusDisplayName((int)profile.Status)
                                </span>
                            </td>
                            <td>
                                <span class="rowact">
                                    <a class="icobtn" href="/salaryprofile-form/@profile.SalaryDecreeId" title="ویرایش">
                                        <svg class="ic"><use href="assets/img/icons.svg#i-pen"/></svg>
                                    </a>
                                    <button class="icobtn danger" title="حذف"
                                            @onclick="() => ConfirmDelete(profile)"
                                            disabled="@_isDeleting">
                                        <svg class="ic"><use href="assets/img/icons.svg#i-trash"/></svg>
                                    </button>
                                </span>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @if (_salaryProfiles is not null && _salaryProfiles.Items.Count > 0)
    {
        <div class="panel-f">
            نمایش @_salaryProfiles.Items.Count.ToPersianNumber() حکم از @_salaryProfiles.TotalCount.ToPersianNumber()

            @if (_totalPages > 1)
            {
                <div class="d-flex justify-content-center align-items-center gap-2 ms-auto">
                    <button class="btn btn-g" disabled="@(_pageNumber <= 1)"
                            @onclick="() => GoToPage(_pageNumber - 1)">
                        قبلی
                    </button>

                    @foreach (var pageNum in GetPageNumbers())
                    {
                        if (pageNum == -1)
                        {
                            <span style="padding:0 8px">...</span>
                        }
                        else
                        {
                            <button class="btn @(pageNum == _pageNumber ? "btn-p" : "btn-g")"
                                    @onclick="() => GoToPage(pageNum)">
                                @pageNum
                            </button>
                        }
                    }

                    <button class="btn btn-g" disabled="@(_pageNumber >= _totalPages)"
                            @onclick="() => GoToPage(_pageNumber + 1)">
                        بعدی
                    </button>
                </div>
            }
        </div>
    }
</div>

@if (_profileToDelete is not null)
{
    <div class="modal-backdrop show" style="z-index:1040"></div>
    <div class="modal show d-block" tabindex="-1" style="z-index:1050">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">تأیید حذف</h5>
                    <button type="button" class="btn-close" @onclick="CancelDelete" disabled="@_isDeleting"></button>
                </div>
                <div class="modal-body">
                    <p>آیا از حذف حکم <b>«@_profileToDelete.EmployeeName»</b> (از @_profileToDelete.DisplayEffectiveFrom) اطمینان دارید؟</p>
                    <p class="text-danger" style="font-size:12px">این عملیات قابل بازگشت نیست.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-g" @onclick="CancelDelete" disabled="@_isDeleting">انصراف</button>
                    <button class="btn btn-danger" @onclick="DeleteProfile" disabled="@_isDeleting">
                        @if (_isDeleting)
                        {
                            <span>در حال حذف...</span>
                        }
                        else
                        {
                            <span>حذف</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private GetSalaryDecreesResponsePagedResult? _salaryProfiles;
    private List<GetUserWorkshopsNameQueryResponseWorkshopName>? _userWorkshops;
    private List<GetUserDepartmentsNameQueryResponseDepartmentName>? _userDepartments;
    private bool _isLoading;
    private string? _search;
    private string _selectedWorkshopId = string.Empty;
    private string _selectedDepartmentId = string.Empty;
    private string _selectedStatus = string.Empty;

    private int _pageNumber = 1;
    private const int PageSize = 10;
    private int _totalPages => _salaryProfiles is null
        ? 0
        : (int)Math.Ceiling(_salaryProfiles.TotalCount / (decimal)PageSize);

    private Timer? _debounceTimer;
    private GetSalaryDecreesResponse? _profileToDelete;
    private bool _isDeleting;

    protected override async Task OnInitializedAsync()
    {
        await LoadWorkshopsAsync();
        await LoadDepartmentsAsync();
        await LoadSalaryProfilesAsync();
    }

    private async Task LoadWorkshopsAsync()
    {
        var result = await ApiService.SendAsync(() => ApiClient.GetUserWorkshopsNameAsync());
        if (result?.IsSuccess is true)
        {
            _userWorkshops = result.Response.WorkshopNames.ToList();
        }
    }

    private async Task LoadDepartmentsAsync()
    {
        if (string.IsNullOrEmpty(_selectedWorkshopId))
        {
            var result = await ApiService.SendAsync(() => ApiClient.GetUserDepartmentsNameAsync());
            if (result?.IsSuccess is true)
            {
                _userDepartments = result.Response.DepartmentNames.ToList();
            }

            return;
        }

        var workshopId = Guid.Parse(_selectedWorkshopId);
        var resultFiltered = await ApiService.SendAsync(() => ApiClient.GetUserDepartmentsAsync(1, 100, null, null, workshopId));
        if (resultFiltered?.IsSuccess is true)
        {
            _userDepartments = resultFiltered.Response.Items
                .Select(x => new GetUserDepartmentsNameQueryResponseDepartmentName(x.Id, x.Name))
                .ToList();
        }
    }

    private async Task LoadSalaryProfilesAsync()
    {
        _isLoading = true;
        StateHasChanged();

        Guid? workshopId = string.IsNullOrEmpty(_selectedWorkshopId)
            ? null
            : Guid.Parse(_selectedWorkshopId);

        Guid? departmentId = string.IsNullOrEmpty(_selectedDepartmentId)
            ? null
            : Guid.Parse(_selectedDepartmentId);

        Status2? status = string.IsNullOrEmpty(_selectedStatus)
            ? null
            : Enum.Parse<Status2>(_selectedStatus);

        var searchTerm = string.IsNullOrWhiteSpace(_search) ? null : _search.Trim();

        var result = await ApiService.SendAsync(() => ApiClient.GetSalaryDecreesAsync(
            _pageNumber,
            PageSize,
            null,
            null,
            searchTerm,
            status,
            workshopId,
            departmentId));

        if (result?.IsSuccess is true)
        {
            _salaryProfiles = result.Response;
        }

        _isLoading = false;
        StateHasChanged();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString();
        _debounceTimer?.Dispose();
        _debounceTimer = new Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                _pageNumber = 1;
                await LoadSalaryProfilesAsync();
            });
        }, null, 500, Timeout.Infinite);
    }

    private async Task OnWorkshopChanged()
    {
        _selectedDepartmentId = string.Empty;
        _pageNumber = 1;
        await LoadDepartmentsAsync();
        await LoadSalaryProfilesAsync();
    }

    private async Task OnDepartmentChanged()
    {
        _pageNumber = 1;
        await LoadSalaryProfilesAsync();
    }

    private async Task OnStatusChanged()
    {
        _pageNumber = 1;
        await LoadSalaryProfilesAsync();
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > _totalPages || page == _pageNumber) return;
        _pageNumber = page;
        await LoadSalaryProfilesAsync();
    }

    private IEnumerable<int> GetPageNumbers()
    {
        const int visible = 5;
        if (_totalPages <= visible + 2)
        {
            for (var i = 1; i <= _totalPages; i++) yield return i;
            yield break;
        }

        yield return 1;

        var start = Math.Max(2, _pageNumber - visible / 2);
        var end = Math.Min(_totalPages - 1, start + visible - 1);
        start = Math.Max(2, end - visible + 1);

        if (start > 2) yield return -1;
        for (var i = start; i <= end; i++) yield return i;
        if (end < _totalPages - 1) yield return -1;

        yield return _totalPages;
    }

    private void ConfirmDelete(GetSalaryDecreesResponse profile)
    {
        _profileToDelete = profile;
    }

    private void CancelDelete()
    {
        if (_isDeleting) return;
        _profileToDelete = null;
    }

    private async Task DeleteProfile()
    {
        if (_profileToDelete is null || _isDeleting) return;

        _isDeleting = true;

        var result = await ApiService.SendAsync(
            apiCall: () => ApiClient.DeleteSalaryDecreeAsync(
                _profileToDelete.SalaryDecreeId,
                _profileToDelete.EmployeeId),
            successMessage: "حکم با موفقیت حذف شد."
        );

        _isDeleting = false;

        if (result?.IsSuccess is true)
        {
            _profileToDelete = null;

            if (_salaryProfiles?.Items.Count == 1 && _pageNumber > 1)
            {
                _pageNumber--;
            }

            await LoadSalaryProfilesAsync();
        }
    }

    private static string FormatAmount(decimal amount) => ((long)amount).ToPersianNumber();

    private static string GetStatusDisplayName(int status) => status switch
    {
        0 => "فعال",
        1 => "منقضی",
        _ => "نامشخص"
    };

    private static string GetStatusChipClass(int status) => status switch
    {
        0 => "c-grn",
        1 => "c-gray",
        _ => "c-gray"
    };

    public void Dispose()
    {
        _debounceTimer?.Dispose();
    }
}
